generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===== M-02: AUTH & USERS =====

enum UserRole {
  SUPER_ADMIN
  GENERAL_MANAGER
  PRODUCTION_MANAGER
  INVENTORY_MANAGER
  ACCOUNTANT
  CASHIER
  HR_MANAGER
  VIEWER
}

model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  phone      String?  @unique
  password   String
  role       UserRole @default(VIEWER)
  isActive   Boolean  @default(true)
  // SEC-F04: رقم إصدار جلسة JWT — كل logout/refresh-rotation يزيّده
  // فيبطل كل الـ access tokens السابقة. تدقق عليه JwtStrategy.validate.
  // P0 fix (wave 7): @map يطابق العمود jwt_version الذي أنشأته migration
  // 20260902000000_wave4_sec_f04_refresh_tokens — بدونه كل استعلام يفشل بـ P2022.
  jwtVersion Int      @default(0) @map("jwt_version")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activityLogs           ActivityLog[]
  salesOrders            SalesOrder[]
  purchaseOrders         PurchaseOrder[]
  purchaseReceipts       PurchaseReceipt[]
  vouchers               Voucher[]
  // E1: القيود المالية التي أنشأها هذا المستخدم.
  journalEntries         JournalEntry[]                  @relation("JournalEntryCreator")
  // A9: القيود المالية التي عكسها هذا المستخدم (audit trail).
  reversedJournalEntries JournalEntry[]                  @relation("JournalEntryReverser")
  workOrders             WorkOrder[]
  stockLedgerEntries     StockLedgerEntry[]
  stageTransitions       WorkOrderStageTransition[]
  productionConsumptions ProductionMaterialConsumption[]
  productionCosts        ProductionCostSnapshot[]
  qualityChecksCreated   QualityCheck[]                  @relation("QualityCheckCreator")

  payrollsCreated      Payroll[]      @relation("PayrollCreator")
  payrollsApproved     Payroll[]      @relation("PayrollApprover")
  fiscalPeriodsCreated FiscalPeriod[] @relation("FiscalPeriodCreator")
  shipmentsDelivered   Shipment[]     @relation("ShipmentDeliverer")
  salesReturns         SalesReturn[]

  // SELIM-ERP W1: العلاقات العكسية للنماذج الجديدة (عروض الأسعار،
  // الخزينة، المصاريف، الورديات، قبض العمال، مرتجع المشتريات، التسويات،
  // القص، العبوات، سجلات الطباعة، كشوف الرواتب المجمدة).
  quotationsCreated          Quotation[]           @relation("QuotationCreator")
  treasuryTransactions       TreasuryTransaction[] @relation("TreasuryTransactionCreator")
  expensesCreated            Expense[]             @relation("ExpenseCreator")
  shiftSessionsOpened        ShiftSession[]        @relation("ShiftOpener")
  workerReceiptsCreated      WorkerReceipt[]       @relation("WorkerReceiptCreator")
  purchaseReturnsCreated     PurchaseReturn[]      @relation("PurchaseReturnCreator")
  adjustmentsCreated         InventoryAdjustment[] @relation("AdjustmentCreator")
  adjustmentsApproved        InventoryAdjustment[] @relation("AdjustmentApprover")
  cuttingOrdersCreated       CuttingOrder[]        @relation("CuttingCreator")
  cuttingOrdersReversed      CuttingOrder[]        @relation("CuttingReverser")
  packsCreated               Pack[]                @relation("PackCreator")
  printLogs                  PrintLog[]            @relation("PrintLogUser")
  payrollStatementsApproved  PayrollStatement[]    @relation("PayrollStatementApprover")

  // SEC-F04: refresh tokens الصادرة لهذا المستخدم (نشطة أو ملغاة).
  refreshTokens RefreshToken[]

  @@map("users")
}

// SEC-F04: Refresh token model مع rotation + revocation.
// - tokenHash: sha256(القيمة الأصلية) — لا نخزّن القيمة الأصلية أبدًا.
// - expiresAt: انتهاء الصلاحية (default 30d).
// - revokedAt: null ما دام نشطًا؛ يُملأ عند الـ logout أو rotation.
// - replacedById: الـ token الذي حلّ محلّه بعد rotation — يسهّل تدقيق السلسلة.
model RefreshToken {
  id           String    @id @default(uuid())
  // P0 fix (wave 7): أعمدة snake_case بـ @map — migration الموجة 4 أنشأ الجدول
  // بأسماء snake_case بينما النموذج كان بلا @map → P2022 ColumnNotFound على
  // كل استعلام (login/refresh/logout). لا تغيير في القاعدة نفسها — مطابقة فقط.
  userId       String    @map("user_id")
  // sha256 hex — 64 حرفًا. لا نقارن بالنص الأصلي أبدًا.
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  createdAt    DateTime  @default(now()) @map("created_at")

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SEC-F04: علاقة استبدال (rotation). كل token قد يُستبدل بواحد جديد؛
  // ونُبقيها one-to-many للسماح بتدقيق السلسلة دون قيد uniqueness معيق.
  replacedBy RefreshToken?  @relation("RefreshTokenReplacedBy", fields: [replacedById], references: [id])
  replaces   RefreshToken[] @relation("RefreshTokenReplacedBy")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  module    String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  // audit-DB: فهرس تصفح سجل التدقيق بحسب الوحدة زمنيًا.
  @@index([module, createdAt])
  @@map("activity_logs")
}

// ===== M-03: PRODUCT CATALOG =====

model Season {
  id        String    @id @default(uuid())
  name      String
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())

  @@map("seasons")
}

model Product {
  id             String    @id @default(uuid())
  code           String    @unique
  name           String
  description    String?
  imageUrl       String?
  seasonId       String?
  category       String?
  retailPrice    Decimal   @db.Decimal(10, 2)
  wholesalePrice Decimal   @db.Decimal(10, 2)
  // SELIM-ERP W1: مستويات الأسعار الأربعة (قطاعي/نصف جملة/جملة/B2B) —
  // يقلد Item prices في Selim ERP. halfWholesalePrice وb2bPrice اختياريان
  // (nullable) لأن القيمة الافتراضية = wholesalePrice عند الغياب.
  halfWholesalePrice Decimal? @db.Decimal(10, 2)
  b2bPrice           Decimal? @db.Decimal(10, 2)
  // SELIM-ERP W1: حد إعادة الطلب (reorderLevel) — تنبيهات انخفاض المخزون
  // في لوحة التحكم تقارن الرصيد المتاح بهذا الحد (يقلد Item.reorderLevel).
  reorderLevel     Decimal? @db.Decimal(10, 4)
  barcode          String?  @unique
  isActive       Boolean   @default(true)
  // E2: soft-delete — المنتج يُعلَّم كمحذوف بدل الحذف الفعلي (audit trail).
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  season      Season?          @relation(fields: [seasonId], references: [id])
  variants    ProductVariant[]
  bomVersions BomVersion[]
  // SELIM-ERP W1: بنود عروض الأسعار وأوامر القص على الموديل الرئيسي.
  quotationItems QuotationItem[]
  cuttingOrders  CuttingOrder[]   @relation("CuttingProduct")

  // E2: composite index على (isActive, deletedAt) — الفلتر المشترك في كل الاستعلامات.
  @@index([isActive, deletedAt])
  @@index([seasonId])
  // audit-DB: ترتيب قوائم المنتجات زمنيًا (createdAt DESC).
  @@index([createdAt])
  @@map("products")
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  size      String
  color     String
  barcode   String? @unique
  isActive  Boolean @default(true)

  product            Product             @relation(fields: [productId], references: [id])
  inventoryItems     FinishedGood[]
  finishedGoodStocks FinishedGoodStock[]
  orderItems         SalesOrderItem[]
  stockLedgerEntries StockLedgerEntry[]
  workOrders         WorkOrder[]
  // SELIM-ERP W1: رابط بسجل الألوان (اختياري — color يبقى لقطة نصية
  // للتوافق مع البيانات القديمة)، وعلاقات بنود عروض الأسعار/التسويات/
  // القص/العبوات.
  colorId            String?
  colorRef           Color?              @relation(fields: [colorId], references: [id], onDelete: SetNull)
  quotationItems     QuotationItem[]
  adjustmentItems    InventoryAdjustmentItem[]
  cuttingLines       CuttingLine[]
  packComponents     PackComponent[]

  @@unique([productId, size, color])
  @@map("product_variants")
}

model BomVersion {
  id          String   @id @default(uuid())
  productId   String
  versionName String // e.g. "v1.0" or "صيف 2026 - الإصدار الأساسي"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  product    Product     @relation(fields: [productId], references: [id])
  lines      BomLine[]
  workOrders WorkOrder[]

  @@index([productId])
  @@map("bom_versions")
}

model BomLine {
  id            String  @id @default(uuid())
  bomVersionId  String
  rawMaterialId String
  quantity      Decimal @db.Decimal(10, 4)
  unit          String

  bomVersion  BomVersion  @relation(fields: [bomVersionId], references: [id])
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@unique([bomVersionId, rawMaterialId])
  // audit-DB: استعلام "أي BOMs تستخدم الخامة X" — آخر FK غير مفهرس.
  @@index([rawMaterialId])
  @@map("bom_lines")
}

// ===== M-04: INVENTORY =====

enum RawMaterialUnit {
  METER
  KILOGRAM
  PIECE
  ROLL
  DOZEN
  LITER
}

model RawMaterial {
  id            String          @id @default(uuid())
  code          String          @unique
  name          String
  unit          RawMaterialUnit
  // GF-0007 / ADR-0007: لا يُحدَّث هذا الرصيد إلا عبر InventoryService بحركة
  // StockLedgerEntry داخل prisma.$transaction — وقيد CHECK (>= 0) في قاعدة البيانات.
  currentStock  Decimal         @default(0) @db.Decimal(10, 4)
  // GF-0007 / ADR-0008: التكلفة الحالية = متوسط مرجح (Weighted Average) يُعاد
  // احتسابه مع كل استلام (RECEIVE) داخل نفس transaction الحركة.
  costPerUnit   Decimal         @db.Decimal(10, 2)
  minStockLevel Decimal         @default(0) @db.Decimal(10, 4)
  supplierId    String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  supplier               Supplier?                       @relation(fields: [supplierId], references: [id])
  transactions           RawMaterialTransaction[]
  bomLines               BomLine[]
  purchaseItems          PurchaseOrderItem[]
  consumptions           MaterialConsumption[]
  productionConsumptions ProductionMaterialConsumption[]
  ledgerEntries          StockLedgerEntry[]
  // SELIM-ERP W1: بنود مرتجع المشتريات + بنود تسويات الجرد للخامة.
  purchaseReturnItems    PurchaseReturnItem[]
  adjustmentItems        InventoryAdjustmentItem[]

  @@index([code, isActive])
  @@index([supplierId])
  @@map("raw_materials")
}

enum TransactionType {
  PURCHASE
  PRODUCTION_USE
  ADJUSTMENT
  RETURN
  WASTE
}

// GF-0007: نموذج قديم (legacy) — أنشئه مسار add-stock السابق. أُوقف الكتابة إليه
// بعد اعتماد StockLedgerEntry كسجل الحركات الموحد (قابل للتدقيق). يُحتفظ به
// للقراءة والتوافق فقط؛ الحذف أو الترحيل الكامل يقرر بعد استقرار المرحلة 3.
model RawMaterialTransaction {
  id            String          @id @default(uuid())
  rawMaterialId String
  type          TransactionType
  quantity      Decimal         @db.Decimal(10, 4)
  costPerUnit   Decimal         @db.Decimal(10, 2)
  reference     String?
  notes         String?
  createdAt     DateTime        @default(now())

  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@index([rawMaterialId])
  @@map("raw_material_transactions")
}

model FinishedGood {
  id               String @id @default(uuid())
  productVariantId String @unique
  // Legacy aggregate retained for backward compatibility. New operational
  // balances are represented by FinishedGoodStock per warehouse and SKU.
  quantity         Int    @default(0)

  variant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@map("finished_goods")
}

// GF-0013: authoritative finished-good balance by warehouse and SKU.
// Updates must be accompanied by StockLedgerEntry in one transaction.
model FinishedGoodStock {
  id               String   @id @default(uuid())
  warehouseId      String
  productVariantId String
  quantity         Int      @default(0)
  unitCost         Decimal  @default(0) @db.Decimal(14, 4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([warehouseId, productVariantId])
  @@index([productVariantId, quantity])
  @@index([warehouseId, quantity])
  // audit-DB: فهرس قيمة المخزون التام لكل متغير (تقارير التقييم).
  @@index([productVariantId, unitCost])
  @@map("finished_good_stocks")
}

// ===== GF-0007: DOMAIN FOUNDATION — WAREHOUSE / STOCK LEDGER / IDEMPOTENCY =====

enum WarehouseType {
  RAW_MATERIAL
  FINISHED_GOODS
  GENERAL
}

// المخازن — تُنشأ في seed (WH-RAW / WH-FG) وأي حركة مخزون تلزم بتحديدها.
model Warehouse {
  id        String        @id @default(uuid())
  code      String        @unique
  name      String
  type      WarehouseType @default(RAW_MATERIAL)
  isActive  Boolean       @default(true)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  ledgerEntries          StockLedgerEntry[]
  productionConsumptions ProductionMaterialConsumption[]
  finishedGoodStocks     FinishedGoodStock[]
  // SELIM-ERP W1: تسويات الجرد وأوامر القص على هذا المخزن.
  adjustments            InventoryAdjustment[]
  cuttingOrders          CuttingOrder[]    @relation("CuttingWarehouse")

  @@index([type, isActive])
  @@map("warehouses")
}

// أنواع حركات المخزون الموحدة في الـ ledger:
// RECEIVE (+كمية، يعيد احتساب متوسط التكلفة المرجح) · ISSUE (−صرف للإنتاج/البيع) ·
// ADJUSTMENT (±تسوية جرد) · WASTE (−هدر) · RETURN (+مرتجع — يُفعّل في GF-0009)
enum StockMovementType {
  RECEIVE
  ISSUE
  ADJUSTMENT
  WASTE
  RETURN
}

// سجل حركات المخزون الموحد — مصدر الحقيقة للتدقيق (append-only):
// كل تغيير على RawMaterial.currentStock يصاحبه سطر واحد هنا داخل نفس
// prisma.$transaction. balanceAfter لقطة لرصيد المستودع المحدد في الحركة؛
// أما المطابقة الإجمالية فتعتمد على currentStock == SUM(quantityDelta) لكل خامة.
model StockLedgerEntry {
  id               String            @id @default(uuid())
  entryCode        String            @unique
  type             StockMovementType
  warehouseId      String
  rawMaterialId    String?
  productVariantId String?
  // موقعة: موجب = دخول، سالب = خروج
  quantityDelta    Decimal           @db.Decimal(12, 4)
  // لقطة الرصيد بعد الحركة (سلسلة تدقيق)
  balanceAfter     Decimal           @db.Decimal(12, 4)
  unitCost         Decimal?          @db.Decimal(10, 4)
  totalValue       Decimal?          @db.Decimal(14, 2)
  reference        String?
  notes            String?
  idempotencyKeyId String?
  createdById      String?
  createdAt        DateTime          @default(now())

  warehouse             Warehouse                      @relation(fields: [warehouseId], references: [id])
  rawMaterial           RawMaterial?                   @relation(fields: [rawMaterialId], references: [id])
  productVariant        ProductVariant?                @relation(fields: [productVariantId], references: [id])
  idempotencyKey        IdempotencyKey?                @relation(fields: [idempotencyKeyId], references: [id])
  createdBy             User?                          @relation(fields: [createdById], references: [id])
  productionConsumption ProductionMaterialConsumption?

  // GF-0007: indexes الأداء — الأكواد (entryCode unique أعلاه)، التواريخ، الحالات
  @@index([rawMaterialId, createdAt])
  @@index([productVariantId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
  @@index([idempotencyKeyId])
  @@index([createdById])
  @@map("stock_ledger_entries")
}

// مفاتيح idempotency — تمنع تكرار نفس العملية عند retry من العميل (الهاتف):
// السجل يُنشأ ويُستكمل بالاستجابة داخل نفس transaction الحركة، فوجوده يعني
// اكتمالها؛ وإعادة الإرسال بنفس المفتاح تعيد الاستجابة المخزنة بلا أثر جديد.
model IdempotencyKey {
  id          String    @id @default(uuid())
  key         String    @unique
  scope       String
  requestHash String
  response    Json?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  ledgerEntries         StockLedgerEntry[]
  stageTransition       WorkOrderStageTransition?
  stageOutput           ProductionStageRun?
  productionConsumption ProductionMaterialConsumption?
  qualityCheck          QualityCheck?
  purchaseReceipt       PurchaseReceipt?
  shipment              Shipment?

  payroll     Payroll?
  salesReturn SalesReturn?

  @@index([scope, createdAt])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ===== M-05: PRODUCTION =====

enum WorkOrderStatus {
  PLANNED
  // القيم التالية legacy؛ المرحلة الحالية الجديدة محفوظة في ProductionStage.
  CUTTING
  SEWING
  FINISHING
  IRONING
  PACKAGING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// GF-0013: مراحل التصنيع الفعلية، منفصلة عن دورة حياة أمر التشغيل.
enum ProductionStage {
  CUTTING
  SEWING
  IRONING
  PACKING
}

enum ProductionStageRunStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProductionCostStatus {
  ESTIMATED
  FINALIZED
}

model WorkOrder {
  id               String           @id @default(uuid())
  code             String           @unique
  productVariantId String
  bomVersionId     String
  quantity         Int
  status           WorkOrderStatus  @default(PLANNED)
  // GF-0013: المرحلة الحالية مستقلة عن lifecycle status، وتبقى nullable للتوافق مع الصفوف القديمة.
  currentStage     ProductionStage?
  stageVersion     Int              @default(1)
  startDate        DateTime?
  endDate          DateTime?
  completedQty     Int              @default(0)
  rejectedQty      Int              @default(0)
  wasteQty         Int              @default(0)
  createdById      String
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  variant                ProductVariant                  @relation(fields: [productVariantId], references: [id])
  bomVersion             BomVersion                      @relation(fields: [bomVersionId], references: [id])
  createdBy              User                            @relation(fields: [createdById], references: [id])
  stageUpdates           WorkOrderStage[]
  qualityChecks          QualityCheck[]
  materialConsumptions   MaterialConsumption[]
  workerProductions      DailyProduction[]
  stageRuns              ProductionStageRun[]
  stageTransitions       WorkOrderStageTransition[]
  productionConsumptions ProductionMaterialConsumption[]
  costSnapshots          ProductionCostSnapshot[]

  @@index([status, currentStage])
  @@index([productVariantId, status])
  @@index([bomVersionId])
  @@index([createdById])
  // audit-DB: ترتيب قوائم أوامر التشغيل زمنيًا (createdAt DESC).
  @@index([createdAt])
  @@map("work_orders")
}

// Legacy stage log retained for backward compatibility. GF-0013 uses
// ProductionStageRun and WorkOrderStageTransition for the authoritative flow.
model WorkOrderStage {
  id          String          @id @default(uuid())
  workOrderId String
  stage       WorkOrderStatus
  quantity    Int
  notes       String?
  createdAt   DateTime        @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@index([workOrderId])
  @@map("work_order_stages")
}

enum QualityWasteReason {
  NATURAL_LOSS
  DEFECT_RELATED
  HUMAN_ERROR
  MATERIAL_DEFECT
  OTHER
}

enum QualityCheckStatus {
  COMPLETED
  VOIDED
}

enum ProductionWasteReason {
  CUTTING_LOSS
  SEWING_DEFECT
  IRONING_LOSS
  PACKAGING_DAMAGE
  MATERIAL_DEFECT
  OTHER
}

// GF-0013: تنفيذ مرحلة فعلية ضمن أمر التشغيل. الكميات بوحدة المنتج (قطعة).
model ProductionStageRun {
  id               String                   @id @default(uuid())
  workOrderId      String
  stage            ProductionStage
  sequence         Int
  status           ProductionStageRunStatus @default(PENDING)
  plannedQty       Int                      @default(0)
  inputQty         Int                      @default(0)
  acceptedQty      Int                      @default(0)
  rejectedQty      Int                      @default(0)
  wasteQty         Int                      @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  notes            String?
  idempotencyKeyId String?                  @unique
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  workOrder            WorkOrder                       @relation(fields: [workOrderId], references: [id])
  materialConsumptions ProductionMaterialConsumption[]
  fromTransitions      WorkOrderStageTransition[]      @relation("StageTransitionFromRun")
  toTransitions        WorkOrderStageTransition[]      @relation("StageTransitionToRun")
  qualityChecks        QualityCheck[]
  idempotencyKey       IdempotencyKey?                 @relation(fields: [idempotencyKeyId], references: [id])

  @@unique([workOrderId, stage])
  @@unique([workOrderId, sequence])
  @@index([workOrderId, status])
  @@map("production_stage_runs")
}

// سجل append-only لكل انتقال حتى يمكن تدقيق من نقل الأمر ومتى ولماذا.
model WorkOrderStageTransition {
  id               String           @id @default(uuid())
  workOrderId      String
  fromStage        ProductionStage?
  toStage          ProductionStage
  fromStatus       WorkOrderStatus?
  toStatus         WorkOrderStatus?
  actorId          String
  reason           String?
  idempotencyKeyId String?          @unique
  createdAt        DateTime         @default(now())

  workOrder      WorkOrder           @relation(fields: [workOrderId], references: [id])
  fromRun        ProductionStageRun? @relation("StageTransitionFromRun", fields: [fromRunId], references: [id])
  fromRunId      String?
  toRun          ProductionStageRun? @relation("StageTransitionToRun", fields: [toRunId], references: [id])
  toRunId        String?
  actor          User                @relation(fields: [actorId], references: [id])
  idempotencyKey IdempotencyKey?     @relation(fields: [idempotencyKeyId], references: [id])

  @@index([workOrderId, createdAt])
  @@index([workOrderId, toStage])
  @@index([actorId])
  @@index([fromRunId])
  @@index([toRunId])
  @@map("work_order_stage_transitions")
}

// سجل استهلاك فعلي لكل خامة ومرحلة؛ الحركة المخزنية المرتبطة هي مصدر الأثر.
model ProductionMaterialConsumption {
  id                 String                 @id @default(uuid())
  workOrderId        String
  stageRunId         String
  rawMaterialId      String
  warehouseId        String
  stockLedgerEntryId String?                @unique
  idempotencyKeyId   String?                @unique
  plannedQuantity    Decimal                @default(0) @db.Decimal(12, 4)
  actualQuantity     Decimal                @db.Decimal(12, 4)
  variance           Decimal                @default(0) @db.Decimal(12, 4)
  wasteQuantity      Decimal                @default(0) @db.Decimal(12, 4)
  unit               String
  unitCost           Decimal                @db.Decimal(12, 4)
  totalCost          Decimal                @db.Decimal(14, 2)
  wasteCost          Decimal                @default(0) @db.Decimal(14, 2)
  wasteReason        ProductionWasteReason?

  notes       String?
  createdById String
  createdAt   DateTime @default(now())

  workOrder        WorkOrder          @relation(fields: [workOrderId], references: [id])
  stageRun         ProductionStageRun @relation(fields: [stageRunId], references: [id])
  rawMaterial      RawMaterial        @relation(fields: [rawMaterialId], references: [id])
  warehouse        Warehouse          @relation(fields: [warehouseId], references: [id])
  stockLedgerEntry StockLedgerEntry?  @relation(fields: [stockLedgerEntryId], references: [id])
  idempotencyKey   IdempotencyKey?    @relation(fields: [idempotencyKeyId], references: [id])
  createdBy        User               @relation(fields: [createdById], references: [id])

  @@index([workOrderId, stageRunId])
  @@index([rawMaterialId, warehouseId, createdAt])
  @@index([createdById, createdAt])
  @@map("production_material_consumptions")
}

// لقطة تكلفة قابلة للتدقيق؛ labor/overhead محجوزان مستقبلًا وقيمتهما الافتراضية صفر.
model ProductionCostSnapshot {
  id           String               @id @default(uuid())
  workOrderId  String
  status       ProductionCostStatus @default(ESTIMATED)
  materialCost Decimal              @default(0) @db.Decimal(14, 2)
  laborCost    Decimal              @default(0) @db.Decimal(14, 2)
  overheadCost Decimal              @default(0) @db.Decimal(14, 2)
  wasteCost    Decimal              @default(0) @db.Decimal(14, 2)
  totalCost    Decimal              @db.Decimal(14, 2)
  acceptedQty  Int                  @default(0)
  unitCost     Decimal?             @db.Decimal(14, 4)
  capturedAt   DateTime             @default(now())
  createdById  String?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  createdBy User?     @relation(fields: [createdById], references: [id])

  @@unique([workOrderId, status])
  @@index([workOrderId, capturedAt])
  @@index([createdById])
  @@map("production_cost_snapshots")
}

model MaterialConsumption {
  id            String   @id @default(uuid())
  workOrderId   String
  rawMaterialId String
  quantity      Decimal  @db.Decimal(10, 4)
  costPerUnit   Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  workOrder   WorkOrder   @relation(fields: [workOrderId], references: [id])
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@index([rawMaterialId])
  @@index([workOrderId])
  @@map("material_consumptions")
}

// ===== M-06: QUALITY CONTROL =====

enum RejectionReason {
  SEWING_DEFECT
  CUTTING_DEFECT
  FABRIC_DEFECT
  FINISHING_DEFECT
  PACKAGING_DEFECT
  OTHER
}

model QualityCheck {
  id               String              @id @default(uuid())
  workOrderId      String
  // QLT-2 (GF-IMP-W3): النوع الدلالي الصحيح — كان WorkOrderStatus (قيمة
  // تراثية تُترجم عبر خريطة LEGACY_STAGE) والآن ProductionStage مباشرة
  // (الهجرة 20260906200000_wave3_qlt2_stage_type تترجم القيم القديمة).
  stage            ProductionStage
  stageRunId       String?
  checkedQty       Int
  passedQty        Int
  rejectedQty      Int
  wasteQty         Int                 @default(0)
  rejectionReason  RejectionReason?
  wasteReason      QualityWasteReason?
  unitCost         Decimal             @default(0) @db.Decimal(14, 4)
  wasteCost        Decimal             @default(0) @db.Decimal(14, 2)
  status           QualityCheckStatus  @default(COMPLETED)
  createdById      String?
  idempotencyKeyId String?
  closedAt         DateTime            @default(now())
  notes            String?
  checkedAt        DateTime            @default(now())
  workOrder        WorkOrder           @relation(fields: [workOrderId], references: [id])
  stageRun         ProductionStageRun? @relation(fields: [stageRunId], references: [id], onDelete: SetNull)
  createdBy        User?               @relation("QualityCheckCreator", fields: [createdById], references: [id], onDelete: SetNull)
  idempotencyKey   IdempotencyKey?     @relation(fields: [idempotencyKeyId], references: [id], onDelete: SetNull)

  @@unique([idempotencyKeyId])
  @@unique([stageRunId])
  @@index([workOrderId, stage, checkedAt])
  @@index([stageRunId, checkedAt])
  @@index([createdById, checkedAt])
  @@map("quality_checks")
}

// ===== M-07: HR & PAYROLL =====

enum PayrollStatus {
  DRAFT
  APPROVED
  // COMM-F04: حالة "مدفوع" — يضعها payPayroll بعد تنفيذ القيد المالي وصرف
  // الراتب. تميّز هذه الحالة بين الكشف المعتمد غير المدفوع والكشف المدفوع،
  // فلا يبقى الاعتماد والصرف يتشاركان حالة APPROVED واحدة (وهو ما كان يكسر
  // الـ state machine قبل هذه الإضافة).
  PAID
}

enum WorkerSpecialty {
  CUTTING
  SEWING
  FINISHING
  PACKAGING
  IRONING
  QUALITY_CONTROL
  OTHER
}

model Worker {
  id         String          @id @default(uuid())
  code       String          @unique
  name       String
  phone      String?
  nationalId String?         @unique
  specialty  WorkerSpecialty
  pieceRate  Decimal         @default(0) @db.Decimal(10, 2)
  isActive   Boolean         @default(true)
  hireDate   DateTime        @default(now())
  createdAt  DateTime        @default(now())

  attendance      Attendance[]
  dailyProduction DailyProduction[]
  advances        WorkerAdvance[]
  payrolls        Payroll[]
  // SELIM-ERP W1: سندات القبض وأوامر القص للعامل.
  receipts        WorkerReceipt[]
  cuttingOrders   CuttingOrder[] @relation("CuttingWorker")

  @@map("workers")
}

model Attendance {
  id        String   @id @default(uuid())
  workerId  String
  date      DateTime @db.Date
  isPresent Boolean  @default(true)
  notes     String?

  worker Worker @relation(fields: [workerId], references: [id])

  @@unique([workerId, date])
  @@map("attendance")
}

model DailyProduction {
  id          String   @id @default(uuid())
  workerId    String
  workOrderId String?
  date        DateTime @db.Date
  piecesCount Int
  pieceRate   Decimal  @db.Decimal(10, 2)
  totalAmount Decimal  @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now())

  worker    Worker     @relation(fields: [workerId], references: [id])
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@index([workOrderId])
  @@index([workerId])
  // audit-DB: فهارس خادمة لتجميعات الرواتب (workerId + نطاق فترة) وتقارير التاريخ.
  @@index([date])
  @@index([workerId, date])
  @@map("daily_production")
}

model WorkerAdvance {
  id       String   @id @default(uuid())
  workerId String
  amount   Decimal  @db.Decimal(10, 2)
  date     DateTime @default(now())
  notes    String?
  // HR-2 (P1 — GF-IMP-W2): الذاكرة الجماعية لتسوية السلف. المتبقي غير
  // المسوى = amount - settledAmount، وهو وحده الذي يدخل حساب خصم السلف
  // في createPayroll (لا الخصم من المبلغ الأصلي كل مرة). يوزَّع الخصم
  // فعليًا على السلف FIFO داخل معاملة payPayroll (settledAmount += المخصص
  // بحد amount) — سلفة بلغت settledAmount == amount مسوية بالكامل ولا
  // تُخصم مرة أخرى. الهجرة: 20260906100000_wave2_unified.
  settledAmount Decimal @default(0) @db.Decimal(10, 2) @map("settled_amount")

  worker Worker @relation(fields: [workerId], references: [id])

  @@index([workerId])
  // audit-DB: فهرس التاريخ يخدم ترتيب FIFO عند تسوية السلف في كشوف الرواتب.
  @@index([date])
  @@map("worker_advances")
}

model Payroll {
  id               String          @id @default(uuid())
  workerId         String
  periodStart      DateTime        @db.Date
  periodEnd        DateTime        @db.Date
  grossAmount      Decimal         @db.Decimal(10, 2)
  advanceDeduct    Decimal         @default(0) @db.Decimal(10, 2)
  absenceDeduct    Decimal         @default(0) @db.Decimal(10, 2)
  netAmount        Decimal         @db.Decimal(10, 2)
  status           PayrollStatus   @default(DRAFT)
  isPaid           Boolean         @default(false)
  paidAt           DateTime?
  notes            String?
  createdById      String?
  approvedById     String?
  approvedAt       DateTime?
  idempotencyKeyId String?
  createdAt        DateTime        @default(now())
  worker           Worker          @relation(fields: [workerId], references: [id])
  createdBy        User?           @relation("PayrollCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy       User?           @relation("PayrollApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  idempotencyKey   IdempotencyKey? @relation(fields: [idempotencyKeyId], references: [id], onDelete: SetNull)
  // SELIM-ERP W1: كشف الرواتب المجمع الذي يضم هذا الكشف (SetNull — حذف
  // الكشف المجمع لا يحذف كشوف العمال المنفردة).
  payrollStatementId String?
  payrollStatement   PayrollStatement? @relation(fields: [payrollStatementId], references: [id], onDelete: SetNull)

  @@unique([workerId, periodStart, periodEnd])
  @@unique([idempotencyKeyId])
  @@index([status, periodStart, periodEnd])
  @@index([createdById, createdAt])
  @@index([approvedById])
  // audit-DB: مسار اعتماد/تدقيق كشوف الرواتب (من اعتمد ومتى).
  @@index([approvedById, approvedAt])
  @@map("payrolls")
}

// ===== M-08: SALES & PURCHASING =====

model Customer {
  id              String    @id @default(uuid())
  code            String    @unique
  name            String
  phone           String?
  address         String?
  email           String?
  notes           String?
  balance         Decimal   @default(0) @db.Decimal(10, 2)
  // Wave 6 — COMM-F07: Customer credit limit (NULL = unlimited).
  // creditLimit من NULL يعني "لا حد ائتماني" (متوافق مع السلوك التاريخي).
  // creditTermsDays: شروط السداد الآجل بالأيام (0 = فوري، 30 = آجل شهر، إلخ).
  creditLimit     Decimal?  @db.Decimal(12, 2)
  creditTermsDays Int       @default(0)
  isActive        Boolean   @default(true)
  // E2: soft-delete — العميل يُعلَّم كمحذوف بدل الحذف الفعلي (audit trail).
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())

  salesOrders  SalesOrder[]
  payments     CustomerPayment[]
  salesReturns SalesReturn[]
  // SELIM-ERP W1: عروض الأسعار المرتبطة بالعميل.
  quotations   Quotation[]

  // E2: composite index على (isActive, deletedAt) — الفلتر المشترك في كل الاستعلامات.
  @@index([isActive, deletedAt])
  @@map("customers")
}

model Supplier {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  phone     String?
  address   String?
  email     String?
  notes     String?
  balance   Decimal   @default(0) @db.Decimal(10, 2)
  isActive  Boolean   @default(true)
  // E2: soft-delete — المورد يُعلَّم كمحذوف بدل الحذف الفعلي (audit trail).
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  purchaseOrders   PurchaseOrder[]
  rawMaterials     RawMaterial[]
  supplierPayments SupplierPayment[]
  // SELIM-ERP W1: مرتجعات المشتريات للمورد.
  purchaseReturns  PurchaseReturn[]

  // E2: composite index على (isActive, deletedAt) — الفلتر المشترك في كل الاستعلامات.
  @@index([isActive, deletedAt])
  @@map("suppliers")
}

enum PaymentType {
  CASH
  CREDIT
  PARTIAL
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  SHIPPED
  CANCELLED
}

model SalesOrder {
  id          String           @id @default(uuid())
  code        String           @unique
  customerId  String
  userId      String
  paymentType PaymentType
  status      SalesOrderStatus @default(DRAFT)
  // A10: VAT 14% Egyptian — subtotal (sum of line items before discount/vat),
  // vatRate (decimal fraction 0.14 = 14%), vatAmount (computed tax), totalAmount
  // (subtotal - discount + vatAmount). Old `totalAmount` field now includes VAT.
  subtotal    Decimal          @default(0) @db.Decimal(12, 2)
  vatRate     Decimal          @default(0) @db.Decimal(5, 4)
  vatAmount   Decimal          @default(0) @db.Decimal(10, 2)
  totalAmount Decimal          @db.Decimal(10, 2)
  paidAmount  Decimal          @default(0) @db.Decimal(10, 2)
  discount    Decimal          @default(0) @db.Decimal(10, 2)
  dueDate     DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  customer  Customer          @relation(fields: [customerId], references: [id])
  user      User              @relation(fields: [userId], references: [id])
  items     SalesOrderItem[]
  payments  CustomerPayment[]
  shipments Shipment[]
  returns   SalesReturn[]
  // SELIM-ERP W1: عروض الأسعار المحوّلة إلى أمر البيع هذا.
  quotations Quotation[]

  // Cluster 2 — A4/B3: فهرس مركب على (status, createdAt) لاستعلامات الـ dashboard
  @@index([status, createdAt])
  @@index([customerId])
  @@index([userId])
  // audit-DB: تقارير ضريبة المبيعات حسب نسبة VAT للأمر.
  @@index([vatRate])
  @@map("sales_orders")
}

model SalesOrderItem {
  id               String  @id @default(uuid())
  salesOrderId     String
  productVariantId String
  quantity         Int
  unitPrice        Decimal @db.Decimal(10, 2)
  totalPrice       Decimal @db.Decimal(10, 2)

  salesOrder  SalesOrder        @relation(fields: [salesOrderId], references: [id])
  variant     ProductVariant    @relation(fields: [productVariantId], references: [id])
  returnItems SalesReturnItem[]

  @@index([productVariantId])
  @@index([salesOrderId])
  @@map("sales_order_items")
}

model CustomerPayment {
  id           String   @id @default(uuid())
  customerId   String
  salesOrderId String?
  amount       Decimal  @db.Decimal(10, 2)
  date         DateTime @default(now())
  notes        String?

  customer   Customer    @relation(fields: [customerId], references: [id])
  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id])

  @@index([customerId])
  @@index([salesOrderId])
  // audit-DB: كشف الذمم وأعمار العملاء (العميل + التاريخ).
  @@index([customerId, date])
  @@map("customer_payments")
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  APPROVED
  RECEIVED
  CANCELLED
}

model SalesReturn {
  id               String   @id @default(uuid())
  code             String   @unique
  salesOrderId     String
  customerId       String
  userId           String
  totalAmount      Decimal  @db.Decimal(10, 2)
  reason           String?
  idempotencyKeyId String?  @unique
  createdAt        DateTime @default(now())

  salesOrder     SalesOrder        @relation(fields: [salesOrderId], references: [id])
  customer       Customer          @relation(fields: [customerId], references: [id])
  user           User              @relation(fields: [userId], references: [id])
  idempotencyKey IdempotencyKey?   @relation(fields: [idempotencyKeyId], references: [id], onDelete: SetNull)
  items          SalesReturnItem[]

  @@index([salesOrderId, createdAt])
  @@index([customerId, createdAt])
  @@index([userId])
  @@map("sales_returns")
}

model SalesReturnItem {
  id               String  @id @default(uuid())
  salesReturnId    String
  salesOrderItemId String
  quantity         Int
  unitPrice        Decimal @db.Decimal(10, 2)
  totalPrice       Decimal @db.Decimal(10, 2)

  salesReturn    SalesReturn    @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])

  @@unique([salesReturnId, salesOrderItemId])
  @@map("sales_return_items")
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  code        String              @unique
  supplierId  String
  userId      String
  paymentType PaymentType
  totalAmount Decimal             @db.Decimal(10, 2)
  paidAmount  Decimal             @default(0) @db.Decimal(10, 2)
  dueDate     DateTime?
  status      PurchaseOrderStatus @default(DRAFT)
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  user     User                @relation(fields: [userId], references: [id])
  items    PurchaseOrderItem[]
  receipts PurchaseReceipt[]
  payments SupplierPayment[]
  // SELIM-ERP W1: مرتجعات المشتريات الصادرة من أمر الشراء هذا.
  purchaseReturns PurchaseReturn[]

  @@index([supplierId])
  @@index([userId])
  // audit-DB: تعادل sales_orders — قوائم المشتريات تفلتر بالحالة وتُرتّب زمنيًا.
  @@index([status, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid())
  purchaseOrderId String
  rawMaterialId   String
  quantity        Decimal @db.Decimal(10, 4)
  unitCost        Decimal @db.Decimal(10, 2)
  totalCost       Decimal @db.Decimal(10, 2)

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  rawMaterial   RawMaterial           @relation(fields: [rawMaterialId], references: [id])
  receiptItems  PurchaseReceiptItem[]
  // SELIM-ERP W1: بنود مرتجع المشتريات الراجعة لهذا البند.
  purchaseReturnItems PurchaseReturnItem[]

  @@index([purchaseOrderId])
  @@index([rawMaterialId])
  @@map("purchase_order_items")
}

model PurchaseReceipt {
  id               String                @id @default(uuid())
  code             String                @unique
  purchaseOrderId  String
  userId           String
  receivedAt       DateTime              @default(now())
  notes            String?
  idempotencyKeyId String?               @unique
  purchaseOrder    PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  user             User                  @relation(fields: [userId], references: [id])
  idempotencyKey   IdempotencyKey?       @relation(fields: [idempotencyKeyId], references: [id], onDelete: SetNull)
  items            PurchaseReceiptItem[]

  @@index([purchaseOrderId, receivedAt])
  @@index([userId])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id                  String  @id @default(uuid())
  receiptId           String
  purchaseOrderItemId String
  quantity            Decimal @db.Decimal(10, 4)

  receipt           PurchaseReceipt   @relation(fields: [receiptId], references: [id])
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])

  @@unique([receiptId, purchaseOrderItemId])
  @@map("purchase_receipt_items")
}

model SupplierPayment {
  id              String   @id @default(uuid())
  supplierId      String
  purchaseOrderId String?
  amount          Decimal  @db.Decimal(10, 2)
  date            DateTime @default(now())
  notes           String?

  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
  @@index([supplierId])
  // audit-DB: كشف ذمم الموردين وأعمارها (المورد + التاريخ).
  @@index([supplierId, date])
  @@map("supplier_payments")
}

// ===== M-09: SHIPPING =====

enum ShipmentStatus {
  PREPARING
  CANCELLED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  RETURNED
}

model ShippingCompany {
  id        String     @id @default(uuid())
  name      String
  phone     String?
  notes     String?
  isActive  Boolean    @default(true)
  shipments Shipment[]

  @@map("shipping_companies")
}

model Shipment {
  id                String         @id @default(uuid())
  code              String         @unique
  salesOrderId      String
  shippingCompanyId String?
  status            ShipmentStatus @default(PREPARING)
  shippingCost      Decimal        @default(0) @db.Decimal(10, 2)
  trackingNumber    String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  proofOfDelivery   String?
  deliveredById     String?
  notes             String?
  idempotencyKeyId  String?        @unique
  createdAt         DateTime       @default(now())

  salesOrder      SalesOrder       @relation(fields: [salesOrderId], references: [id])
  deliveredBy     User?            @relation("ShipmentDeliverer", fields: [deliveredById], references: [id], onDelete: SetNull)
  shippingCompany ShippingCompany? @relation(fields: [shippingCompanyId], references: [id])
  idempotencyKey  IdempotencyKey?  @relation(fields: [idempotencyKeyId], references: [id], onDelete: SetNull) // GF-IMP-W2 / INF-8: توحيد نمط التنظيف على SetNull

  @@index([deliveredById])
  @@index([salesOrderId])
  @@index([shippingCompanyId])
  // audit-DB: تتبع حالة الشحنات المؤكدة وتواريخ التسليم (تقارير POD).
  @@index([status, deliveredAt])
  // audit-DB: قوائم الشحنات تفلتر بالحالة وتُرتّب زمنيًا.
  @@index([status, createdAt])
  // GF-IMP-W1 / SHP-1: يوجد أيضًا فهرس فريد جزئي شحنة نشطة واحدة كحد أقصى
  // لكل أمر بيع (shipments_active_per_order_unique ON "salesOrderId" WHERE
  // "status" IN ('PREPARING','IN_TRANSIT')) يعيش في الهجرة
  // 20260906000000_wave1_shp1_unique_active_shipment ولا يُصرَّح هنا — فهارس
  // SQL الجزئية غير قابلة للتعبير في مخطط Prisma. أي تعديل على سلوكه يبدأ
  // من الهجرة لا من هذا المخطط.
  @@map("shipments")
}

// ===== M-10: ACCOUNTING =====

enum FiscalPeriodStatus {
  OPEN
  CLOSED
}

model FiscalPeriod {
  id          String             @id @default(uuid())
  name        String
  startDate   DateTime           @db.Date
  endDate     DateTime           @db.Date
  status      FiscalPeriodStatus @default(OPEN)
  createdById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  createdBy      User           @relation("FiscalPeriodCreator", fields: [createdById], references: [id])
  journalEntries JournalEntry[]

  @@unique([startDate, endDate])
  @@index([status, startDate, endDate])
  @@index([createdById])
  @@map("fiscal_periods")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id        String      @id @default(uuid())
  code      String      @unique
  name      String
  type      AccountType
  parentId  String?
  isGroup   Boolean     @default(false)
  balance   Decimal     @default(0) @db.Decimal(15, 2)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  parent      Account?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    Account[]     @relation("AccountHierarchy")
  debitLines  JournalLine[] @relation("DebitAccount")
  creditLines JournalLine[] @relation("CreditAccount")
  // SELIM-ERP W1: الميزانيات المخططة على هذا الحساب.
  budgets    Budget[]

  @@index([parentId])
  @@map("accounts")
}

model JournalEntry {
  id             String    @id @default(uuid())
  code           String    @unique
  description    String
  reference      String?
  date           DateTime  @default(now())
  isAuto         Boolean   @default(false)
  // E1: audit trail — من أنشأ القيد (nullable للقيود الالية).
  createdById    String?
  createdAt      DateTime  @default(now())
  // A9: reversal tracking — القيد الأصلي يُعلَّم كمعكوس، والقيد العكسي يربط بـ reversalOfId.
  // لا cascade delete — العلاقة استشارية لحفظ سجل المراجعة.
  isReversed     Boolean   @default(false)
  reversalOfId   String?
  reversedById   String?
  reversedAt     DateTime?
  // A9: payload of linked side effects used for atomic reversal.
  metadata       Json?
  // Financial posting idempotency: same key + same hash replays; different hash conflicts.
  postingKey     String?
  postingHash    String?
  // E5: multi-currency — العملة التي أُنشئ بها القيد + سعر الصرف مقابل عملة النظام.
  // NULL = system default (EGP). exchangeRate defaults to 1.0 when currencyId is NULL.
  currencyId     String?
  exchangeRate   Decimal?  @db.Decimal(10, 6)
  fiscalPeriodId String?
  // Wave 6 — SCHEMA-F01 follow-up: expose debitTotal / creditTotal columns that were
  // added by migration 20260831110000_wave2_v2_fix_balance_trigger but were missing
  // from the prisma model. They are populated by an AFTER INSERT/UPDATE/DELETE trigger
  // on journal_lines (`enforce_journal_entry_balance`) and protected by a column-level
  // CHECK constraint (journal_entries_debit_credit_balance_check).
  debitTotal     Decimal   @default(0) @db.Decimal(20, 2)
  creditTotal    Decimal   @default(0) @db.Decimal(20, 2)

  lines        JournalLine[]
  fiscalPeriod FiscalPeriod?  @relation(fields: [fiscalPeriodId], references: [id])
  // E1: علاقة اختيارية للمستخدم (لا cascade delete — لا تُحذف القيود).
  createdBy    User?          @relation("JournalEntryCreator", fields: [createdById], references: [id])
  // A9: من عكس القيد (audit trail).
  reversedBy   User?          @relation("JournalEntryReverser", fields: [reversedById], references: [id])
  // A9: علاقة ذاتية للربط بين القيد العكسي والأصلي.
  reversalOf   JournalEntry?  @relation("JournalEntryReversal", fields: [reversalOfId], references: [id])
  reversals    JournalEntry[] @relation("JournalEntryReversal")
  // E5: FK to Currency (nullable — defaults to system EGP).
  currency     Currency?      @relation(fields: [currencyId], references: [id])
  vouchers     Voucher[]
  // SELIM-ERP W1: القيود المرتبطة بحركات الخزينة/المصاريف/قبض العمال/
  // كشوف الرواتب المجمدة/مرتجعات المشتريات.
  treasuryTransactions TreasuryTransaction[] @relation("TreasuryTransactionJournal")
  expenses             Expense[]             @relation("ExpenseJournal")
  workerReceipts       WorkerReceipt[]       @relation("WorkerReceiptJournal")
  payrollStatements    PayrollStatement[]    @relation("PayrollStatementJournal")
  purchaseReturns      PurchaseReturn[]      @relation("PurchaseReturnJournal")

  @@unique([reversalOfId])
  @@unique([postingKey])
  // Cluster 2 — B5/E4: فهارس للتقارير وحساب السنة المالية
  // A9: فهارس لاستعلامات العكس (المؤجلة / المنفذة).
  // E5: فهرس على currencyId لتقارير العملات الأجنبية.
  @@index([date])
  @@index([createdById, createdAt])
  @@index([reversalOfId])
  @@index([isReversed])
  @@index([currencyId])
  @@index([fiscalPeriodId, date])
  @@index([reversedById])
  @@map("journal_entries")
}

model JournalLine {
  id              String  @id @default(uuid())
  journalEntryId  String
  debitAccountId  String
  creditAccountId String
  amount          Decimal @db.Decimal(15, 2)
  description     String?

  journalEntry  JournalEntry @relation(fields: [journalEntryId], references: [id])
  debitAccount  Account      @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccount Account      @relation("CreditAccount", fields: [creditAccountId], references: [id])

  @@index([creditAccountId])
  @@index([debitAccountId])
  @@index([journalEntryId])
  @@map("journal_lines")
}

enum VoucherType {
  PAYMENT
  RECEIPT
}

model Voucher {
  id          String      @id @default(uuid())
  code        String      @unique
  type        VoucherType
  amount      Decimal     @db.Decimal(10, 2)
  description String
  reference   String?
  date        DateTime    @default(now())
  createdById String
  createdAt   DateTime    @default(now())

  // A3: ربط السند بقيد مالي حقيقي (لا قيد لا سند — لا أثر مالي خفي).
  journalEntryId   String?
  treasuryId       String?
  // SCHEMA-F02 (polymorphic counterparty design):
  //   `counterpartyType` + `counterpartyId` is a polymorphic reference — the
  //   counterparty can be a Customer, Supplier, Worker, Treasury, or NONE (for
  //   vouchers without a specific counterparty).
  //   The DB enforces the whitelist via a NOT-VALID CHECK constraint (added by
  //   migration 20260831113000_wave2_v2_voucher_counterparty_check):
  //     counterpartyType IS NULL OR
  //     counterpartyType IN ('CUSTOMER','SUPPLIER','WORKER','TREASURY','NONE')
  //   No FK is enforced at the DB level (the counterparty can live in any of
  //   several tables). The runtime entity-existence check is the responsibility
  //   of the VoucherService — TODO: enforce in service layer before persisting
  //   (raise BadRequestException if counterpartyId does not resolve to a real
  //   Customer/Supplier/Worker/Treasury row). A future refactor may replace
  //   this polymorphic pattern with three nullable FK columns
  //   (customerId/supplierId/workerId) + an XOR CHECK.
  counterpartyType String?
  counterpartyId   String?

  // SELIM-ERP W1: المصاريف المدفوعة عبر هذا السند.
  expensesPaid Expense[] @relation("ExpenseVoucher")

  // SCHEMA-F03: `createdById` is NOT NULL (init migration), so the relation
  //   must be required and `onDelete: Restrict` (matching the init migration's
  //   ON DELETE RESTRICT). Prevents a User with vouchers from being deleted.
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
  treasury     Treasury?     @relation(fields: [treasuryId], references: [id])

  // Cluster 2 — C5/C8: فهارس لتسريع استعلامات الـ treasury حسب النوع والتاريخ
  @@index([type, date])
  @@index([counterpartyId])
  // audit-DB: جلب سندات طرف بعينه (تقرير كشف حساب الطرف من السندات).
  @@index([counterpartyType, counterpartyId])
  @@index([createdById])
  @@index([journalEntryId])
  @@index([treasuryId])
  @@map("vouchers")
}

model Treasury {
  id         String    @id @default(uuid())
  name       String
  type       String // CASH or BANK
  balance    Decimal   @default(0) @db.Decimal(15, 2)
  isActive   Boolean   @default(true)
  // E2: soft-delete — الخزينة يُعلَّم كمحذوف بدل الحذف الفعلي (audit trail).
  // ملاحظة: لا تسمح بـ soft-delete إذا كان balance != 0 (يُيتم سندات مرتبطة).
  deletedAt  DateTime?
  // E5: multi-currency — كل خزينة لها عملة (EGP default).
  currencyId String?
  createdAt  DateTime  @default(now())

  // A3: السندات المرتبطة بهذه الخزينة (لا cascade delete — يُمنع حذف خزينة مرتبطة).
  vouchers Voucher[]
  // E5: FK to Currency (nullable for backfill — future PR makes it required).
  currency Currency? @relation(fields: [currencyId], references: [id])
  // SELIM-ERP W1: حركات الخزينة (إيداع/سحب/تحويل) الصادرة والواردة،
  // المصاريف المسحوبة منها، وسندات قبض العمال.
  treasuryTransactionsFrom TreasuryTransaction[] @relation("TreasuryTransactionSource")
  treasuryTransactionsTo   TreasuryTransaction[] @relation("TreasuryTransactionTarget")
  expenses                 Expense[]             @relation("ExpenseTreasury")
  workerReceipts           WorkerReceipt[]       @relation("WorkerReceiptTreasury")

  // Cluster 2 — B5: فهرس على isActive لفلترة الخزائن النشطة
  // E2: composite index على (isActive, deletedAt) — يحل محل الفهرس المنفرد.
  @@index([isActive, deletedAt])
  @@index([currencyId])
  @@map("treasuries")
}

// E5: Multi-currency support — Currency model with ISO 4217 code.
// Seeded with EGP (Egyptian Pound) as the system default + USD as reference.
model Currency {
  id            String   @id @default(uuid())
  code          String   @unique // ISO 4217: EGP, USD, EUR, etc.
  name          String
  symbol        String?
  decimalPlaces Int      @default(2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  treasuries     Treasury[]
  journalEntries JournalEntry[]

  @@map("currencies")
}

model CostCenter {
  id       String  @id @default(uuid())
  name     String
  code     String  @unique
  isActive Boolean @default(true)

  // SELIM-ERP W1: الميزانيات المخططة على مركز التكلفة هذا.
  budgets  Budget[]

  @@map("cost_centers")
}

// ============================================================================
// SELIM-ERP REPLICATION WAVE 1 — نماذج جديدة منسوخة من نظام Selim ERP
// (مشروع ويب مرجعي) ومُكيّفة مع معمارية هذا المشروع (مستأجر واحد،
// uuid ids، أدوار UserRole، ومحرك القيود المالي الموحد).
// كل نموذج يتبع نفس قواعد الكود الحالي: تعليقات عربية تشرح القاعدة
// التجارية، فهارس مركبة للاستعلامات الشائعة، وOnDelete صارم للجداول
// المالية (Restrict) لضمان سلسلة التدقيق.
// ============================================================================

// ---------------------------------------------------------------------------
// الترقيم التسلسلي الذري (SEQ) — يقلد Sequence في Selim ERP:
// "INV-0001" / "PR-0001" / "CUT-00001". upsert ذري بقفل الصف يمنع
// التكرار تحت التزامن (increment: 1 داخل نفس المعاملة).
// ---------------------------------------------------------------------------
model Sequence {
  id        String   @id @default(uuid())
  type      String   // QUOTATION | PURCHASE_RETURN | CUTTING_ORDER | PAYROLL_STATEMENT | PACK ...
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([type])
  @@map("sequences")
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CONVERTED
}

// ---------------------------------------------------------------------------
// عرض السعر (QUO) — يقلد Quotation في Selim ERP: مسودة → مُرسَل →
// مقبول → مُحوَّل لأمر بيع، مع صلاحية السريان (validUntil) وبنود نصية
// مرنة (اسم الصنف لقطة + رابط اختياري بالمنتج/التوليفة).
// ---------------------------------------------------------------------------
model Quotation {
  id            String           @id @default(uuid())
  quotationNo   String           @unique // SEQ-QUOTATION: "QUO-0001"
  customerId    String?
  customerName  String // لقطة الاسم — العرض يبقى مقروءًا لو حُذف العميل
  date          DateTime         @default(now())
  validUntil    DateTime?
  subtotal      Decimal          @default(0) @db.Decimal(12, 2)
  discount      Decimal          @default(0) @db.Decimal(10, 2)
  vatRate       Decimal          @default(0) @db.Decimal(5, 4)
  vatAmount     Decimal          @default(0) @db.Decimal(10, 2)
  total         Decimal          @db.Decimal(12, 2)
  status        QuotationStatus  @default(DRAFT)
  notes         String?
  // التحويل: عند CONVERTED يُخزَّن أمر البيع الناتج (Restrict — لا يُحذف
  // أمر بيع له عرض مصدر).
  salesOrderId  String?
  createdById   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  customer   Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  salesOrder SalesOrder?   @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  createdBy  User?         @relation("QuotationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items      QuotationItem[]

  @@index([status, date])
  @@index([customerId])
  @@index([date])
  @@map("quotations")
}

model QuotationItem {
  id              String  @id @default(uuid())
  quotationId     String
  productId       String?
  productVariantId String?
  productName     String // لقطة اسم الصنف وقت الإنشاء
  quantity        Decimal @db.Decimal(10, 4)
  unitPrice       Decimal @db.Decimal(10, 2)
  total           Decimal @db.Decimal(12, 2)
  notes           String?

  quotation     Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product       Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@index([productId])
  @@index([productVariantId])
  @@map("quotation_items")
}

enum TreasuryTransactionType {
  DEPOSIT // إيداع
  WITHDRAWAL // سحب
  TRANSFER // تحويل بين خزينتين
}

// ---------------------------------------------------------------------------
// حركة الخزينة (TRT) — يقلد TreasuryTransaction في Selim ERP: إيداع/سحب/
// تحويل مع فئة ومرجع اختياري. ترتبط بقيد مالي حقيقي (journalEntryId)
// وتحدّث رصيد الخزينة داخل نفس المعاملة — لا أثر مالي بلا قيد.
// ---------------------------------------------------------------------------
model TreasuryTransaction {
  id             String                 @id @default(uuid())
  code           String                 @unique // SEQ: "TRT-0001"
  treasuryId     String
  toTreasuryId   String? // للتحويل فقط
  type           TreasuryTransactionType
  amount         Decimal                @db.Decimal(10, 2)
  date           DateTime               @default(now())
  description    String
  category       String? // مبيعات | رأس مال | قرض | مصاريف | رواتب | إيجار | أخرى
  referenceType  String? // PAYMENT | EXPENSE | WORKER_RECEIPT | SHIFT ...
  referenceId    String?
  notes          String?
  journalEntryId String?
  createdById    String?
  createdAt      DateTime               @default(now())

  treasury     Treasury       @relation("TreasuryTransactionSource", fields: [treasuryId], references: [id])
  toTreasury   Treasury?      @relation("TreasuryTransactionTarget", fields: [toTreasuryId], references: [id])
  journalEntry JournalEntry?  @relation("TreasuryTransactionJournal", fields: [journalEntryId], references: [id])
  createdBy    User?          @relation("TreasuryTransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([type, date])
  @@index([treasuryId, date])
  @@index([date])
  @@index([referenceType, referenceId])
  @@map("treasury_transactions")
}

// ---------------------------------------------------------------------------
// بنود المصاريف (EXC) — فئات مصاريف يديرها المستخدم (يقلد ExpenseCategory).
// name فريد — لا ازدواج في البنود.
// ---------------------------------------------------------------------------
model ExpenseCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  expenses Expense[]

  @@index([isActive])
  @@map("expense_categories")
}

// ---------------------------------------------------------------------------
// المصروف (EXP) — يقلد Expense في Selim ERP: مبلغ + بند + تاريخ،
// ويرتبط اختياريًا بالخزينة المسحوب منها وبقيد مالي (لا قيد لا أثر).
// ---------------------------------------------------------------------------
model Expense {
  id             String   @id @default(uuid())
  categoryId     String
  categoryName   String // لقطة اسم البند
  amount         Decimal  @db.Decimal(10, 2)
  date           DateTime @default(now())
  notes          String?
  treasuryId     String?
  voucherId      String?
  journalEntryId String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category     ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  treasury     Treasury?       @relation("ExpenseTreasury", fields: [treasuryId], references: [id])
  voucher      Voucher?        @relation("ExpenseVoucher", fields: [voucherId], references: [id])
  journalEntry JournalEntry?   @relation("ExpenseJournal", fields: [journalEntryId], references: [id])
  createdBy    User?           @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([categoryId, date])
  @@index([date])
  @@index([treasuryId])
  @@map("expenses")
}

enum ShiftStatus {
  OPEN
  CLOSED
}

// ---------------------------------------------------------------------------
// وردية البيع (SHF) — يقلد ShiftSession في Selim ERP: يفتحها البائع
// برصيد افتتاحي ويغلقها بعد جرد الصندوق (متوقع مقابل معدود والفرق).
// فاتورة بيع جديدة تتطلب وردية مفتوحة (نفس قاعدة Selim).
// ---------------------------------------------------------------------------
model ShiftSession {
  id           String      @id @default(uuid())
  code         String      @unique // SEQ: "SHF-0001"
  openedById   String
  openedByName String // لقطة الاسم
  startTime    DateTime    @default(now())
  endTime      DateTime?
  startCash    Decimal     @default(0) @db.Decimal(10, 2)
  expectedCash Decimal?    @db.Decimal(10, 2)
  endCash      Decimal?    @db.Decimal(10, 2)
  difference   Decimal?    @db.Decimal(10, 2)
  status       ShiftStatus @default(OPEN)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  openedBy User @relation("ShiftOpener", fields: [openedById], references: [id], onDelete: Restrict)

  @@unique([openedById, status, startTime])
  @@index([status, startTime])
  @@index([openedById])
  @@map("shift_sessions")
}

// ---------------------------------------------------------------------------
// سند قبض عامل (WRC) — يقلد WorkerReceipt في Selim ERP: مبلغ يُقبض من
// العامل (تسوية سلفة/مديونية). يرتبط بقيد مالي + خزينة اختيارية.
// Restrict لا Cascade — سندات العامل مالية ولا تُحذف بحذفه.
// ---------------------------------------------------------------------------
model WorkerReceipt {
  id             String   @id @default(uuid())
  code           String   @unique // SEQ: "WRC-0001"
  workerId       String
  amount         Decimal  @db.Decimal(10, 2)
  date           DateTime @default(now())
  notes          String?
  treasuryId     String?
  journalEntryId String?
  createdById    String?
  createdAt      DateTime @default(now())

  worker       Worker         @relation(fields: [workerId], references: [id], onDelete: Restrict)
  treasury     Treasury?      @relation("WorkerReceiptTreasury", fields: [treasuryId], references: [id])
  journalEntry JournalEntry?  @relation("WorkerReceiptJournal", fields: [journalEntryId], references: [id])
  createdBy    User?          @relation("WorkerReceiptCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workerId, date])
  @@index([date])
  @@map("worker_receipts")
}

enum PayrollStatementStatus {
  DRAFT
  POSTED
}

// ---------------------------------------------------------------------------
// كشف الرواتب المجمع (PSM) — يقلد PayrollStatement في Selim ERP: يجمع
// كشوف رواتب شهر كامل في مستند واحد (lines/totals JSON snapshot)،
// يُرحَّل بقيد واحد عند الاعتماد، وكل Payroll مرتبط به يصبح isPaid.
// ---------------------------------------------------------------------------
model PayrollStatement {
  id             String                @id @default(uuid())
  code           String                @unique // SEQ: "PSM-0001"
  periodFrom     DateTime              @db.Date
  periodTo       DateTime              @db.Date
  status         PayrollStatementStatus @default(DRAFT)
  lines          Json                  @default("[]") // لقطة صفوف العمال
  totals         Json                  @default("{}") // {gross, deductions, net}
  workerCount    Int                   @default(0)
  approvedById   String?
  approvedAt     DateTime?
  notes          String?
  journalEntryId String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  approvedBy   User?         @relation("PayrollStatementApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  journalEntry JournalEntry? @relation("PayrollStatementJournal", fields: [journalEntryId], references: [id])
  payrolls     Payroll[]

  @@unique([periodFrom, periodTo])
  @@index([status, periodFrom])
  @@map("payroll_statements")
}

enum PurchaseReturnStatus {
  DRAFT
  POSTED
}

// ---------------------------------------------------------------------------
// مرتجع المشتريات (PRR) — يقلد PurchaseReturn في Selim ERP: إرجاع خامات
// للمورد بخصم من رصيد المورد (credit) أو استرداد نقدي (cash)، مع خيار
// إرجاع المخزون فعليًا (restockItems=false يخصم دون تحريك الرصيد).
// القيد العكسي داخل نفس معاملة الإنشاء — لا مرتجع بلا قيد.
// ---------------------------------------------------------------------------
model PurchaseReturn {
  id            String             @id @default(uuid())
  returnNumber  String             @unique // SEQ: "PRR-0001"
  purchaseOrderId String           // أمر الشراء الأصل
  supplierId    String?
  supplierName  String // لقطة
  invoiceNo     String?
  date          DateTime           @default(now())
  subtotal      Decimal            @default(0) @db.Decimal(12, 2)
  discountAmount Decimal           @default(0) @db.Decimal(10, 2)
  taxAmount     Decimal            @default(0) @db.Decimal(10, 2)
  total         Decimal            @db.Decimal(12, 2)
  reason        String?
  restockItems  Boolean            @default(true)
  refundMethod  String             @default("credit") // credit | cash
  status        PurchaseReturnStatus @default(POSTED)
  notes         String?
  journalEntryId String?
  createdById   String?
  createdAt     DateTime           @default(now())

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  journalEntry JournalEntry?   @relation("PurchaseReturnJournal", fields: [journalEntryId], references: [id])
  createdBy     User?          @relation("PurchaseReturnCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items         PurchaseReturnItem[]

  @@index([purchaseOrderId])
  @@index([supplierId, date])
  @@index([date])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id                String  @id @default(uuid())
  purchaseReturnId  String
  purchaseOrderItemId String? // البند الأصل (اختياري — قد يُرجع صنف بلا بند أصل)
  rawMaterialId     String?
  rawMaterialName   String // لقطة
  quantity          Decimal @db.Decimal(10, 4)
  unitPrice         Decimal @db.Decimal(10, 2)
  unitCost          Decimal  @default(0) @db.Decimal(10, 2) // التكلفة الفعلية للاسترداد
  total             Decimal @db.Decimal(12, 2)
  reason            String?

  purchaseReturn  PurchaseReturn    @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)
  rawMaterial     RawMaterial?      @relation(fields: [rawMaterialId], references: [id], onDelete: SetNull)

  @@index([purchaseReturnId])
  @@index([purchaseOrderItemId])
  @@index([rawMaterialId])
  @@map("purchase_return_items")
}

enum AdjustmentStatus {
  DRAFT
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// تسوية الجرد (ADJ) — يقلد InventoryAdjustment في Selim ERP: مسودة تعداد
// فعلي مقابل دفتري، لا تلمس المخزون إلا عند الاعتماد (APPROVED) حيث
// تُنشأ حركات StockLedgerEntry لكل بند. الرفض يحفظ المسودة للتدقيق.
// ---------------------------------------------------------------------------
model InventoryAdjustment {
  id          String            @id @default(uuid())
  code        String            @unique // SEQ: "ADJ-0001"
  warehouseId String
  date        DateTime          @default(now())
  status      AdjustmentStatus  @default(DRAFT)
  notes       String?
  createdById String?
  approvedById String?
  approvedAt  DateTime?
  rejectedReason String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  warehouse  Warehouse                  @relation(fields: [warehouseId], references: [id])
  createdBy  User?                      @relation("AdjustmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?                      @relation("AdjustmentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  items      InventoryAdjustmentItem[]

  @@index([status, date])
  @@index([warehouseId, date])
  @@map("inventory_adjustments")
}

model InventoryAdjustmentItem {
  id               String  @id @default(uuid())
  adjustmentId     String
  // نفس نمط StockLedgerEntry: إما خام أو توليفة منتج — XOR في طبقة الخدمة.
  rawMaterialId    String?
  productVariantId String?
  itemName         String // لقطة للعرض
  unit             String // لقطة وحدة القياس
  systemQty        Decimal @db.Decimal(12, 4)
  actualQty        Decimal @db.Decimal(12, 4)
  difference       Decimal @db.Decimal(12, 4) // actual - system
  unitCost         Decimal @db.Decimal(10, 4)
  valueDifference  Decimal @db.Decimal(14, 2) // أثر التسوية المالي
  notes            String?

  adjustment      InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  rawMaterial     RawMaterial?        @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  productVariant  ProductVariant?     @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([adjustmentId])
  @@index([rawMaterialId])
  @@index([productVariantId])
  @@map("inventory_adjustment_items")
}

// ---------------------------------------------------------------------------
// الألوان (CLR) — يقلد Color في Selim ERP: سجل ألوان الشركة بالدرجة
// الست عشرية، يستخدمه تنويعات المنتجات وخطوط القص.
// ---------------------------------------------------------------------------
model Color {
  id        String   @id @default(uuid())
  name      String   @unique // أحمر / نبيتي / كحلي …
  hex       String   // #RRGGBB
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  productVariants ProductVariant[]
  cuttingLines    CuttingLine[]

  @@index([isActive])
  @@map("colors")
}

// ---------------------------------------------------------------------------
// مجموعات المقاسات (SZG) — يقلد SizeGroup في Selim ERP: "شبابي S M L XL"
// مرتبة كما أُدخلت، يستخدمها القص لتنظيم الرقصات.
// ---------------------------------------------------------------------------
model SizeGroup {
  id        String   @id @default(uuid())
  name      String   @unique // شبابي / أطفال / خاص
  sizes     String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  cuttingLines CuttingLine[]

  @@index([isActive])
  @@map("size_groups")
}

enum CuttingOrderStatus {
  DRAFT
  ACTIVE // مُفعَّل — خصم الرئيسي وإدخال التوليفات تم
  REVERSED // معكوس — استُعيدت الحركات
}

// ---------------------------------------------------------------------------
// أمر القص (CUT) — يقلد CuttingOrder في Selim ERP: قص رصيد الموديل
// الرئيسي إلى توليفات (لون×مقاس) عبر رقصات (lays). عند التفعيل:
// ISSUE من رصيد الموديل وRECEIVE لكل توليفة داخل نفس المعاملة،
// وأجر القص للعامل يُقيَّد كإنتاج بالقطعة (قطع × أجر القطعة).
// العكس (REVERSED) يسترجع كل الحركات بدقة من سجلاتها.
// ---------------------------------------------------------------------------
model CuttingOrder {
  id            String             @id @default(uuid())
  docNumber     String             @unique // SEQ: "CUT-0001"
  date          DateTime           @default(now())
  productId     String // الموديل الرئيسي المقصوص
  warehouseId   String
  workerId      String?
  wagePerPiece  Decimal?           @db.Decimal(10, 2) // متوسط مرجّح للعرض
  wageTotal     Decimal            @default(0) @db.Decimal(10, 2)
  remnantQty    Decimal            @default(0) @db.Decimal(12, 4) // البواقي — للمتابعة
  remnantNotes  String?
  totalPieces   Decimal            @default(0) @db.Decimal(12, 4)
  totalLays     Decimal            @default(0) @db.Decimal(12, 4)
  status        CuttingOrderStatus @default(DRAFT)
  reversedAt    DateTime?
  reversedById  String?
  notes         String?
  createdById   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  product     Product        @relation("CuttingProduct", fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse      @relation("CuttingWarehouse", fields: [warehouseId], references: [id])
  worker      Worker?        @relation("CuttingWorker", fields: [workerId], references: [id], onDelete: SetNull)
  reversedBy  User?          @relation("CuttingReverser", fields: [reversedById], references: [id], onDelete: SetNull)
  createdBy   User?          @relation("CuttingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines       CuttingLine[]

  @@index([status, date])
  @@index([productId])
  @@index([workerId])
  @@index([date])
  @@map("cutting_orders")
}

model CuttingLine {
  id              String  @id @default(uuid())
  cuttingOrderId  String
  colorId         String?
  color           String? // لقطة اسم اللون
  sizeGroupId     String?
  size            String // المقاس (S / M / L …)
  layCount        Decimal @default(1) @db.Decimal(12, 4) // عدد الرقصات
  piecesPerLay    Decimal @default(0) @db.Decimal(12, 4)
  quantity        Decimal @db.Decimal(12, 4) // المجموع المستلم للتوليفة
  productVariantId String? // التوليفة الناتجة (تُملأ عند التفعيل)
  notes           String?

  cuttingOrder  CuttingOrder @relation(fields: [cuttingOrderId], references: [id], onDelete: Cascade)
  colorRef      Color?       @relation(fields: [colorId], references: [id], onDelete: SetNull)
  sizeGroup     SizeGroup?   @relation(fields: [sizeGroupId], references: [id], onDelete: SetNull)
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([cuttingOrderId])
  @@index([productVariantId])
  @@index([colorId])
  @@map("cutting_lines")
}

// ---------------------------------------------------------------------------
// العبوة (PACK) — يقلد نظام التعبئة في Selim ERP (Item type=pack +
// PackComponent): كود عبوة (سرية) = مجموعة توليفات بكميات محددة.
// البناء (build) يخصم المكونات ويرد عبوات جاهزة؛ التفكيك يعكسها.
// الحركات كلها عبر StockLedgerEntry داخل معاملة واحدة.
// ---------------------------------------------------------------------------
model Pack {
  id          String   @id @default(uuid())
  code        String   @unique // SEQ: "PACK-0001"
  name        String
  notes       String?
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy  User?           @relation("PackCreator", fields: [createdById], references: [id], onDelete: SetNull)
  components PackComponent[]

  @@index([isActive])
  @@map("packs")
}

model PackComponent {
  id              String  @id @default(uuid())
  packId          String
  productVariantId String
  quantity        Decimal @db.Decimal(12, 4) // الكمية داخل العبوة الواحدة

  pack           Pack           @relation(fields: [packId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([packId, productVariantId])
  @@index([productVariantId])
  @@map("pack_components")
}

// ---------------------------------------------------------------------------
// قوالب الطباعة (PRT) — يقلد PrintTemplate في Selim ERP: إعدادات JSON
// لكل مستند×حجم ورق ({ styles, sections, customElements })، مع isDefault
// لاختيار القالب تلقائيًا عند الطباعة.
// ---------------------------------------------------------------------------
model PrintTemplate {
  id           String   @id @default(uuid())
  name         String
  documentType String // INVOICE | PURCHASE | PRODUCTION_ORDER | MATERIAL_ISSUE | RECEIPT | QUOTATION | VOUCHER | CUTTING
  paperSize    String // 58mm | 80mm | A4 | A5 | A6
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  config       Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  printLogs PrintLog[]

  @@unique([name, documentType, paperSize])
  @@index([documentType, isDefault])
  @@index([paperSize])
  @@map("print_templates")
}

// سجل الطباعة (PRL) — يقلد PrintLog: من طبع ماذا ومتى وبأي قالب وكم
// نسخة وهل هي إعادة طباعة — لتحليل استخدام الطباعة.
model PrintLog {
  id             String   @id @default(uuid())
  userId         String
  userName       String // لقطة
  documentType   String
  documentId     String?
  documentNumber String? // لقطة رقم المستند
  templateId     String?
  templateName   String? // لقطة
  channel        String // app_pdf | thermal | external
  paperSize      String?
  copies         Int      @default(1)
  isReprint      Boolean  @default(false)
  createdAt      DateTime @default(now())

  user   User?         @relation("PrintLogUser", fields: [userId], references: [id], onDelete: SetNull)
  template PrintTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([documentType, documentId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("print_logs")
}

// ---------------------------------------------------------------------------
// قالب القيد (JRT) — يقلد JournalTemplate في Selim ERP: قيود متكررة
// جاهزة (الإيجار الشهري/رواتب…) بأسطر JSON جاهزة للتعبئة والترحيل.
// ---------------------------------------------------------------------------
model JournalTemplate {
  id                String    @id @default(uuid())
  name              String    @unique
  description       String?
  lines             Json      @default("[]") // [{accountId, debit, credit, description}]
  isRecurring       Boolean   @default(false)
  recurrencePattern String?   // monthly | weekly | yearly
  lastUsedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([isRecurring])
  @@map("journal_templates")
}

// ---------------------------------------------------------------------------
// الميزانية (BGT) — يقلد Budget في Selim ERP: مبلغ مخطط لحساب (ومركز
// تكلفة اختياري) لسنة مالية وفترة، يُقارن بالفعلي في تقارير المحاسبة.
// ---------------------------------------------------------------------------
model Budget {
  id           String   @id @default(uuid())
  accountId    String
  costCenterId String?
  fiscalYear   Int
  period       String   @default("yearly") // monthly | quarterly | yearly
  periodIndex  Int      @default(1)
  amount       Decimal  @default(0) @db.Decimal(14, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account    Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  @@index([accountId, fiscalYear])
  @@index([fiscalYear])
  @@map("budgets")
}
