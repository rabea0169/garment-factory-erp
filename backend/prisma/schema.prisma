generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===== M-02: AUTH & USERS =====

enum UserRole {
  SUPER_ADMIN
  GENERAL_MANAGER
  PRODUCTION_MANAGER
  INVENTORY_MANAGER
  ACCOUNTANT
  CASHIER
  HR_MANAGER
  VIEWER
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?  @unique
  password  String
  role      UserRole @default(VIEWER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityLogs           ActivityLog[]
  salesOrders            SalesOrder[]
  purchaseOrders         PurchaseOrder[]
  purchaseReceipts       PurchaseReceipt[]
  vouchers               Voucher[]
  // E1: القيود المالية التي أنشأها هذا المستخدم.
  journalEntries         JournalEntry[]                  @relation("JournalEntryCreator")
  // A9: القيود المالية التي عكسها هذا المستخدم (audit trail).
  reversedJournalEntries JournalEntry[]                  @relation("JournalEntryReverser")
  workOrders             WorkOrder[]
  stockLedgerEntries     StockLedgerEntry[]
  stageTransitions       WorkOrderStageTransition[]
  productionConsumptions ProductionMaterialConsumption[]
  productionCosts        ProductionCostSnapshot[]
  qualityChecksCreated   QualityCheck[]                  @relation("QualityCheckCreator")

  @@map("users")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  module    String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("activity_logs")
}

// ===== M-03: PRODUCT CATALOG =====

model Season {
  id        String    @id @default(uuid())
  name      String
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())

  @@map("seasons")
}

model Product {
  id             String    @id @default(uuid())
  code           String    @unique
  name           String
  description    String?
  imageUrl       String?
  seasonId       String?
  category       String?
  retailPrice    Decimal   @db.Decimal(10, 2)
  wholesalePrice Decimal   @db.Decimal(10, 2)
  isActive       Boolean   @default(true)
  // E2: soft-delete — المنتج يُعلَّم كمحذوف بدل الحذف الفعلي (audit trail).
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  season      Season?          @relation(fields: [seasonId], references: [id])
  variants    ProductVariant[]
  bomVersions BomVersion[]

  // E2: composite index على (isActive, deletedAt) — الفلتر المشترك في كل الاستعلامات.
  @@index([isActive, deletedAt])
  @@map("products")
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  size      String
  color     String
  barcode   String? @unique
  isActive  Boolean @default(true)

  product            Product             @relation(fields: [productId], references: [id])
  inventoryItems     FinishedGood[]
  finishedGoodStocks FinishedGoodStock[]
  orderItems         SalesOrderItem[]
  stockLedgerEntries StockLedgerEntry[]
  workOrders         WorkOrder[]

  @@unique([productId, size, color])
  @@map("product_variants")
}

model BomVersion {
  id          String   @id @default(uuid())
  productId   String
  versionName String // e.g. "v1.0" or "صيف 2026 - الإصدار الأساسي"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  product    Product     @relation(fields: [productId], references: [id])
  lines      BomLine[]
  workOrders WorkOrder[]

  @@map("bom_versions")
}

model BomLine {
  id            String  @id @default(uuid())
  bomVersionId  String
  rawMaterialId String
  quantity      Decimal @db.Decimal(10, 4)
  unit          String

  bomVersion  BomVersion  @relation(fields: [bomVersionId], references: [id])
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@unique([bomVersionId, rawMaterialId])
  @@map("bom_lines")
}

// ===== M-04: INVENTORY =====

enum RawMaterialUnit {
  METER
  KILOGRAM
  PIECE
  ROLL
  DOZEN
  LITER
}

model RawMaterial {
  id            String          @id @default(uuid())
  code          String          @unique
  name          String
  unit          RawMaterialUnit
  // GF-0007 / ADR-0007: لا يُحدَّث هذا الرصيد إلا عبر InventoryService بحركة
  // StockLedgerEntry داخل prisma.$transaction — وقيد CHECK (>= 0) في قاعدة البيانات.
  currentStock  Decimal         @default(0) @db.Decimal(10, 4)
  // GF-0007 / ADR-0008: التكلفة الحالية = متوسط مرجح (Weighted Average) يُعاد
  // احتسابه مع كل استلام (RECEIVE) داخل نفس transaction الحركة.
  costPerUnit   Decimal         @db.Decimal(10, 2)
  minStockLevel Decimal         @default(0) @db.Decimal(10, 4)
  supplierId    String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  supplier               Supplier?                       @relation(fields: [supplierId], references: [id])
  transactions           RawMaterialTransaction[]
  bomLines               BomLine[]
  purchaseItems          PurchaseOrderItem[]
  consumptions           MaterialConsumption[]
  productionConsumptions ProductionMaterialConsumption[]
  ledgerEntries          StockLedgerEntry[]

  @@index([code, isActive])
  @@map("raw_materials")
}

enum TransactionType {
  PURCHASE
  PRODUCTION_USE
  ADJUSTMENT
  RETURN
  WASTE
}

// GF-0007: نموذج قديم (legacy) — أنشئه مسار add-stock السابق. أُوقف الكتابة إليه
// بعد اعتماد StockLedgerEntry كسجل الحركات الموحد (قابل للتدقيق). يُحتفظ به
// للقراءة والتوافق فقط؛ الحذف أو الترحيل الكامل يقرر بعد استقرار المرحلة 3.
model RawMaterialTransaction {
  id            String          @id @default(uuid())
  rawMaterialId String
  type          TransactionType
  quantity      Decimal         @db.Decimal(10, 4)
  costPerUnit   Decimal         @db.Decimal(10, 2)
  reference     String?
  notes         String?
  createdAt     DateTime        @default(now())

  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@map("raw_material_transactions")
}

model FinishedGood {
  id               String @id @default(uuid())
  productVariantId String @unique
  // Legacy aggregate retained for backward compatibility. New operational
  // balances are represented by FinishedGoodStock per warehouse and SKU.
  quantity         Int    @default(0)

  variant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@map("finished_goods")
}

// GF-0013: authoritative finished-good balance by warehouse and SKU.
// Updates must be accompanied by StockLedgerEntry in one transaction.
model FinishedGoodStock {
  id               String   @id @default(uuid())
  warehouseId      String
  productVariantId String
  quantity         Int      @default(0)
  unitCost         Decimal  @default(0) @db.Decimal(14, 4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([warehouseId, productVariantId])
  @@index([productVariantId, quantity])
  @@index([warehouseId, quantity])
  @@map("finished_good_stocks")
}

// ===== GF-0007: DOMAIN FOUNDATION — WAREHOUSE / STOCK LEDGER / IDEMPOTENCY =====

enum WarehouseType {
  RAW_MATERIAL
  FINISHED_GOODS
  GENERAL
}

// المخازن — تُنشأ في seed (WH-RAW / WH-FG) وأي حركة مخزون تلزم بتحديدها.
model Warehouse {
  id        String        @id @default(uuid())
  code      String        @unique
  name      String
  type      WarehouseType @default(RAW_MATERIAL)
  isActive  Boolean       @default(true)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  ledgerEntries          StockLedgerEntry[]
  productionConsumptions ProductionMaterialConsumption[]
  finishedGoodStocks     FinishedGoodStock[]

  @@index([type, isActive])
  @@map("warehouses")
}

// أنواع حركات المخزون الموحدة في الـ ledger:
// RECEIVE (+كمية، يعيد احتساب متوسط التكلفة المرجح) · ISSUE (−صرف للإنتاج/البيع) ·
// ADJUSTMENT (±تسوية جرد) · WASTE (−هدر) · RETURN (+مرتجع — يُفعّل في GF-0009)
enum StockMovementType {
  RECEIVE
  ISSUE
  ADJUSTMENT
  WASTE
  RETURN
}

// سجل حركات المخزون الموحد — مصدر الحقيقة للتدقيق (append-only):
// كل تغيير على RawMaterial.currentStock يصاحبه سطر واحد هنا داخل نفس
// prisma.$transaction، مع لقطة الرصيد بعد الحركة (balanceAfter) لتسهيل
// المطابقة: currentStock == SUM(quantityDelta) لكل خامة.
model StockLedgerEntry {
  id               String            @id @default(uuid())
  entryCode        String            @unique
  type             StockMovementType
  warehouseId      String
  rawMaterialId    String?
  productVariantId String?
  // موقعة: موجب = دخول، سالب = خروج
  quantityDelta    Decimal           @db.Decimal(12, 4)
  // لقطة الرصيد بعد الحركة (سلسلة تدقيق)
  balanceAfter     Decimal           @db.Decimal(12, 4)
  unitCost         Decimal?          @db.Decimal(10, 4)
  totalValue       Decimal?          @db.Decimal(14, 2)
  reference        String?
  notes            String?
  idempotencyKeyId String?
  createdById      String?
  createdAt        DateTime          @default(now())

  warehouse             Warehouse                      @relation(fields: [warehouseId], references: [id])
  rawMaterial           RawMaterial?                   @relation(fields: [rawMaterialId], references: [id])
  productVariant        ProductVariant?                @relation(fields: [productVariantId], references: [id])
  idempotencyKey        IdempotencyKey?                @relation(fields: [idempotencyKeyId], references: [id])
  createdBy             User?                          @relation(fields: [createdById], references: [id])
  productionConsumption ProductionMaterialConsumption?

  // GF-0007: indexes الأداء — الأكواد (entryCode unique أعلاه)، التواريخ، الحالات
  @@index([rawMaterialId, createdAt])
  @@index([productVariantId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
  @@index([idempotencyKeyId])
  @@map("stock_ledger_entries")
}

// مفاتيح idempotency — تمنع تكرار نفس العملية عند retry من العميل (الهاتف):
// السجل يُنشأ ويُستكمل بالاستجابة داخل نفس transaction الحركة، فوجوده يعني
// اكتمالها؛ وإعادة الإرسال بنفس المفتاح تعيد الاستجابة المخزنة بلا أثر جديد.
model IdempotencyKey {
  id          String    @id @default(uuid())
  key         String    @unique
  scope       String
  requestHash String
  response    Json?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  ledgerEntries         StockLedgerEntry[]
  stageTransition       WorkOrderStageTransition?
  productionConsumption ProductionMaterialConsumption?
  qualityCheck          QualityCheck?

  @@index([scope, createdAt])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ===== M-05: PRODUCTION =====

enum WorkOrderStatus {
  PLANNED
  // القيم التالية legacy؛ المرحلة الحالية الجديدة محفوظة في ProductionStage.
  CUTTING
  SEWING
  FINISHING
  IRONING
  PACKAGING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// GF-0013: مراحل التصنيع الفعلية، منفصلة عن دورة حياة أمر التشغيل.
enum ProductionStage {
  CUTTING
  SEWING
  IRONING
  PACKING
}

enum ProductionStageRunStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProductionCostStatus {
  ESTIMATED
  FINALIZED
}

model WorkOrder {
  id               String           @id @default(uuid())
  code             String           @unique
  productVariantId String
  bomVersionId     String
  quantity         Int
  status           WorkOrderStatus  @default(PLANNED)
  // GF-0013: المرحلة الحالية مستقلة عن lifecycle status، وتبقى nullable للتوافق مع الصفوف القديمة.
  currentStage     ProductionStage?
  stageVersion     Int              @default(1)
  startDate        DateTime?
  endDate          DateTime?
  completedQty     Int              @default(0)
  rejectedQty      Int              @default(0)
  wasteQty         Int              @default(0)
  createdById      String
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  variant                ProductVariant                  @relation(fields: [productVariantId], references: [id])
  bomVersion             BomVersion                      @relation(fields: [bomVersionId], references: [id])
  createdBy              User                            @relation(fields: [createdById], references: [id])
  stageUpdates           WorkOrderStage[]
  qualityChecks          QualityCheck[]
  materialConsumptions   MaterialConsumption[]
  workerProductions      DailyProduction[]
  stageRuns              ProductionStageRun[]
  stageTransitions       WorkOrderStageTransition[]
  productionConsumptions ProductionMaterialConsumption[]
  costSnapshots          ProductionCostSnapshot[]

  @@index([status, currentStage])
  @@index([productVariantId, status])
  @@map("work_orders")
}

// Legacy stage log retained for backward compatibility. GF-0013 uses
// ProductionStageRun and WorkOrderStageTransition for the authoritative flow.
model WorkOrderStage {
  id          String          @id @default(uuid())
  workOrderId String
  stage       WorkOrderStatus
  quantity    Int
  notes       String?
  createdAt   DateTime        @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@map("work_order_stages")
}

enum QualityWasteReason {
  NATURAL_LOSS
  DEFECT_RELATED
  HUMAN_ERROR
  MATERIAL_DEFECT
  OTHER
}

enum QualityCheckStatus {
  COMPLETED
  VOIDED
}

enum ProductionWasteReason {
  CUTTING_LOSS
  SEWING_DEFECT
  IRONING_LOSS
  PACKAGING_DAMAGE
  MATERIAL_DEFECT
  OTHER
}

// GF-0013: تنفيذ مرحلة فعلية ضمن أمر التشغيل. الكميات بوحدة المنتج (قطعة).
model ProductionStageRun {
  id          String                   @id @default(uuid())
  workOrderId String
  stage       ProductionStage
  sequence    Int
  status      ProductionStageRunStatus @default(PENDING)
  plannedQty  Int                      @default(0)
  inputQty    Int                      @default(0)
  acceptedQty Int                      @default(0)
  rejectedQty Int                      @default(0)
  wasteQty    Int                      @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  workOrder            WorkOrder                       @relation(fields: [workOrderId], references: [id])
  materialConsumptions ProductionMaterialConsumption[]
  fromTransitions      WorkOrderStageTransition[]      @relation("StageTransitionFromRun")
  toTransitions        WorkOrderStageTransition[]      @relation("StageTransitionToRun")
  qualityChecks        QualityCheck[]

  @@unique([workOrderId, stage])
  @@unique([workOrderId, sequence])
  @@index([workOrderId, status])
  @@map("production_stage_runs")
}

// سجل append-only لكل انتقال حتى يمكن تدقيق من نقل الأمر ومتى ولماذا.
model WorkOrderStageTransition {
  id               String           @id @default(uuid())
  workOrderId      String
  fromStage        ProductionStage?
  toStage          ProductionStage
  fromStatus       WorkOrderStatus?
  toStatus         WorkOrderStatus?
  actorId          String
  reason           String?
  idempotencyKeyId String?          @unique
  createdAt        DateTime         @default(now())

  workOrder      WorkOrder           @relation(fields: [workOrderId], references: [id])
  fromRun        ProductionStageRun? @relation("StageTransitionFromRun", fields: [fromRunId], references: [id])
  fromRunId      String?
  toRun          ProductionStageRun? @relation("StageTransitionToRun", fields: [toRunId], references: [id])
  toRunId        String?
  actor          User                @relation(fields: [actorId], references: [id])
  idempotencyKey IdempotencyKey?     @relation(fields: [idempotencyKeyId], references: [id])

  @@index([workOrderId, createdAt])
  @@index([workOrderId, toStage])
  @@map("work_order_stage_transitions")
}

// سجل استهلاك فعلي لكل خامة ومرحلة؛ الحركة المخزنية المرتبطة هي مصدر الأثر.
model ProductionMaterialConsumption {
  id                 String                 @id @default(uuid())
  workOrderId        String
  stageRunId         String
  rawMaterialId      String
  warehouseId        String
  stockLedgerEntryId String?                @unique
  idempotencyKeyId   String?                @unique
  plannedQuantity    Decimal                @default(0) @db.Decimal(12, 4)
  actualQuantity     Decimal                @db.Decimal(12, 4)
  variance           Decimal                @default(0) @db.Decimal(12, 4)
  wasteQuantity      Decimal                @default(0) @db.Decimal(12, 4)
  unit               String
  unitCost           Decimal                @db.Decimal(12, 4)
  totalCost          Decimal                @db.Decimal(14, 2)
  wasteCost          Decimal                @default(0) @db.Decimal(14, 2)
  wasteReason        ProductionWasteReason?

  notes       String?
  createdById String
  createdAt   DateTime @default(now())

  workOrder        WorkOrder          @relation(fields: [workOrderId], references: [id])
  stageRun         ProductionStageRun @relation(fields: [stageRunId], references: [id])
  rawMaterial      RawMaterial        @relation(fields: [rawMaterialId], references: [id])
  warehouse        Warehouse          @relation(fields: [warehouseId], references: [id])
  stockLedgerEntry StockLedgerEntry?  @relation(fields: [stockLedgerEntryId], references: [id])
  idempotencyKey   IdempotencyKey?    @relation(fields: [idempotencyKeyId], references: [id])
  createdBy        User               @relation(fields: [createdById], references: [id])

  @@index([workOrderId, stageRunId])
  @@index([rawMaterialId, warehouseId, createdAt])
  @@index([createdById, createdAt])
  @@map("production_material_consumptions")
}

// لقطة تكلفة قابلة للتدقيق؛ labor/overhead محجوزان مستقبلًا وقيمتهما الافتراضية صفر.
model ProductionCostSnapshot {
  id           String               @id @default(uuid())
  workOrderId  String
  status       ProductionCostStatus @default(ESTIMATED)
  materialCost Decimal              @default(0) @db.Decimal(14, 2)
  laborCost    Decimal              @default(0) @db.Decimal(14, 2)
  overheadCost Decimal              @default(0) @db.Decimal(14, 2)
  wasteCost    Decimal              @default(0) @db.Decimal(14, 2)
  totalCost    Decimal              @db.Decimal(14, 2)
  acceptedQty  Int                  @default(0)
  unitCost     Decimal?             @db.Decimal(14, 4)
  capturedAt   DateTime             @default(now())
  createdById  String?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  createdBy User?     @relation(fields: [createdById], references: [id])

  @@unique([workOrderId, status])
  @@index([workOrderId, capturedAt])
  @@map("production_cost_snapshots")
}

model MaterialConsumption {
  id            String   @id @default(uuid())
  workOrderId   String
  rawMaterialId String
  quantity      Decimal  @db.Decimal(10, 4)
  costPerUnit   Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  workOrder   WorkOrder   @relation(fields: [workOrderId], references: [id])
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@map("material_consumptions")
}

// ===== M-06: QUALITY CONTROL =====

enum RejectionReason {
  SEWING_DEFECT
  CUTTING_DEFECT
  FABRIC_DEFECT
  FINISHING_DEFECT
  PACKAGING_DEFECT
  OTHER
}

model QualityCheck {
  id               String              @id @default(uuid())
  workOrderId      String
  stage            WorkOrderStatus
  stageRunId       String?
  checkedQty       Int
  passedQty        Int
  rejectedQty      Int
  wasteQty         Int                 @default(0)
  rejectionReason  RejectionReason?
  wasteReason      QualityWasteReason?
  unitCost         Decimal             @default(0) @db.Decimal(14, 4)
  wasteCost        Decimal             @default(0) @db.Decimal(14, 2)
  status           QualityCheckStatus  @default(COMPLETED)
  createdById      String?
  idempotencyKeyId String?
  closedAt         DateTime            @default(now())
  notes            String?
  checkedAt        DateTime            @default(now())
  workOrder        WorkOrder           @relation(fields: [workOrderId], references: [id])
  stageRun         ProductionStageRun? @relation(fields: [stageRunId], references: [id], onDelete: SetNull)
  createdBy        User?               @relation("QualityCheckCreator", fields: [createdById], references: [id], onDelete: SetNull)
  idempotencyKey   IdempotencyKey?     @relation(fields: [idempotencyKeyId], references: [id], onDelete: SetNull)

  @@unique([idempotencyKeyId])
  @@unique([stageRunId])
  @@index([workOrderId, stage, checkedAt])
  @@index([stageRunId, checkedAt])
  @@index([createdById, checkedAt])
  @@map("quality_checks")
}

// ===== M-07: HR & PAYROLL =====

enum WorkerSpecialty {
  CUTTING
  SEWING
  FINISHING
  PACKAGING
  IRONING
  QUALITY_CONTROL
  OTHER
}

model Worker {
  id         String          @id @default(uuid())
  code       String          @unique
  name       String
  phone      String?
  nationalId String?         @unique
  specialty  WorkerSpecialty
  pieceRate  Decimal         @default(0) @db.Decimal(10, 2)
  isActive   Boolean         @default(true)
  hireDate   DateTime        @default(now())
  createdAt  DateTime        @default(now())

  attendance      Attendance[]
  dailyProduction DailyProduction[]
  advances        WorkerAdvance[]
  payrolls        Payroll[]

  @@map("workers")
}

model Attendance {
  id        String   @id @default(uuid())
  workerId  String
  date      DateTime @db.Date
  isPresent Boolean  @default(true)
  notes     String?

  worker Worker @relation(fields: [workerId], references: [id])

  @@unique([workerId, date])
  @@map("attendance")
}

model DailyProduction {
  id          String   @id @default(uuid())
  workerId    String
  workOrderId String?
  date        DateTime @db.Date
  piecesCount Int
  pieceRate   Decimal  @db.Decimal(10, 2)
  totalAmount Decimal  @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now())

  worker    Worker     @relation(fields: [workerId], references: [id])
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@map("daily_production")
}

model WorkerAdvance {
  id       String   @id @default(uuid())
  workerId String
  amount   Decimal  @db.Decimal(10, 2)
  date     DateTime @default(now())
  notes    String?

  worker Worker @relation(fields: [workerId], references: [id])

  @@map("worker_advances")
}

model Payroll {
  id            String    @id @default(uuid())
  workerId      String
  periodStart   DateTime  @db.Date
  periodEnd     DateTime  @db.Date
  grossAmount   Decimal   @db.Decimal(10, 2)
  advanceDeduct Decimal   @default(0) @db.Decimal(10, 2)
  absenceDeduct Decimal   @default(0) @db.Decimal(10, 2)
  netAmount     Decimal   @db.Decimal(10, 2)
  isPaid        Boolean   @default(false)
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  worker Worker @relation(fields: [workerId], references: [id])

  @@map("payrolls")
}

// ===== M-08: SALES & PURCHASING =====

model Customer {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  phone     String?
  address   String?
  email     String?
  notes     String?
  balance   Decimal   @default(0) @db.Decimal(10, 2)
  isActive  Boolean   @default(true)
  // E2: soft-delete — العميل يُعلَّم كمحذوف بدل الحذف الفعلي (audit trail).
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  salesOrders SalesOrder[]
  payments    CustomerPayment[]

  // E2: composite index على (isActive, deletedAt) — الفلتر المشترك في كل الاستعلامات.
  @@index([isActive, deletedAt])
  @@map("customers")
}

model Supplier {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  phone     String?
  address   String?
  email     String?
  notes     String?
  balance   Decimal   @default(0) @db.Decimal(10, 2)
  isActive  Boolean   @default(true)
  // E2: soft-delete — المورد يُعلَّم كمحذوف بدل الحذف الفعلي (audit trail).
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  purchaseOrders   PurchaseOrder[]
  rawMaterials     RawMaterial[]
  supplierPayments SupplierPayment[]

  // E2: composite index على (isActive, deletedAt) — الفلتر المشترك في كل الاستعلامات.
  @@index([isActive, deletedAt])
  @@map("suppliers")
}

enum PaymentType {
  CASH
  CREDIT
  PARTIAL
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  SHIPPED
  CANCELLED
}

model SalesOrder {
  id          String           @id @default(uuid())
  code        String           @unique
  customerId  String
  userId      String
  paymentType PaymentType
  status      SalesOrderStatus @default(DRAFT)
  // A10: VAT 14% Egyptian — subtotal (sum of line items before discount/vat),
  // vatRate (decimal fraction 0.14 = 14%), vatAmount (computed tax), totalAmount
  // (subtotal - discount + vatAmount). Old `totalAmount` field now includes VAT.
  subtotal    Decimal          @default(0) @db.Decimal(12, 2)
  vatRate     Decimal          @default(0) @db.Decimal(5, 4)
  vatAmount   Decimal          @default(0) @db.Decimal(10, 2)
  totalAmount Decimal          @db.Decimal(10, 2)
  paidAmount  Decimal          @default(0) @db.Decimal(10, 2)
  discount    Decimal          @default(0) @db.Decimal(10, 2)
  dueDate     DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  customer  Customer          @relation(fields: [customerId], references: [id])
  user      User              @relation(fields: [userId], references: [id])
  items     SalesOrderItem[]
  payments  CustomerPayment[]
  shipments Shipment[]

  // Cluster 2 — A4/B3: فهرس مركب على (status, createdAt) لاستعلامات الـ dashboard
  @@index([status, createdAt])
  @@map("sales_orders")
}

model SalesOrderItem {
  id               String  @id @default(uuid())
  salesOrderId     String
  productVariantId String
  quantity         Int
  unitPrice        Decimal @db.Decimal(10, 2)
  totalPrice       Decimal @db.Decimal(10, 2)

  salesOrder SalesOrder     @relation(fields: [salesOrderId], references: [id])
  variant    ProductVariant @relation(fields: [productVariantId], references: [id])

  @@map("sales_order_items")
}

model CustomerPayment {
  id           String   @id @default(uuid())
  customerId   String
  salesOrderId String?
  amount       Decimal  @db.Decimal(10, 2)
  date         DateTime @default(now())
  notes        String?

  customer   Customer    @relation(fields: [customerId], references: [id])
  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id])

  @@map("customer_payments")
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  code        String              @unique
  supplierId  String
  userId      String
  paymentType PaymentType
  totalAmount Decimal             @db.Decimal(10, 2)
  paidAmount  Decimal             @default(0) @db.Decimal(10, 2)
  dueDate     DateTime?
  status      PurchaseOrderStatus @default(DRAFT)
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  user     User                @relation(fields: [userId], references: [id])
  items    PurchaseOrderItem[]
  receipts PurchaseReceipt[]
  payments SupplierPayment[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid())
  purchaseOrderId String
  rawMaterialId   String
  quantity        Decimal @db.Decimal(10, 4)
  unitCost        Decimal @db.Decimal(10, 2)
  totalCost       Decimal @db.Decimal(10, 2)

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  rawMaterial   RawMaterial           @relation(fields: [rawMaterialId], references: [id])
  receiptItems  PurchaseReceiptItem[]

  @@map("purchase_order_items")
}

model PurchaseReceipt {
  id              String   @id @default(uuid())
  code            String   @unique
  purchaseOrderId String
  userId          String
  receivedAt      DateTime @default(now())
  notes           String?

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  user          User                  @relation(fields: [userId], references: [id])
  items         PurchaseReceiptItem[]

  @@index([purchaseOrderId, receivedAt])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id                  String  @id @default(uuid())
  receiptId           String
  purchaseOrderItemId String
  quantity            Decimal @db.Decimal(10, 4)

  receipt           PurchaseReceipt   @relation(fields: [receiptId], references: [id])
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])

  @@unique([receiptId, purchaseOrderItemId])
  @@map("purchase_receipt_items")
}

model SupplierPayment {
  id              String   @id @default(uuid())
  supplierId      String
  purchaseOrderId String?
  amount          Decimal  @db.Decimal(10, 2)
  date            DateTime @default(now())
  notes           String?

  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@map("supplier_payments")
}

// ===== M-09: SHIPPING =====

enum ShipmentStatus {
  PREPARING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  RETURNED
}

model ShippingCompany {
  id        String     @id @default(uuid())
  name      String
  phone     String?
  notes     String?
  isActive  Boolean    @default(true)
  shipments Shipment[]

  @@map("shipping_companies")
}

model Shipment {
  id                String         @id @default(uuid())
  code              String         @unique
  salesOrderId      String
  shippingCompanyId String?
  status            ShipmentStatus @default(PREPARING)
  shippingCost      Decimal        @default(0) @db.Decimal(10, 2)
  trackingNumber    String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  notes             String?
  createdAt         DateTime       @default(now())

  salesOrder      SalesOrder       @relation(fields: [salesOrderId], references: [id])
  shippingCompany ShippingCompany? @relation(fields: [shippingCompanyId], references: [id])

  @@map("shipments")
}

// ===== M-10: ACCOUNTING =====

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id        String      @id @default(uuid())
  code      String      @unique
  name      String
  type      AccountType
  parentId  String?
  isGroup   Boolean     @default(false)
  balance   Decimal     @default(0) @db.Decimal(15, 2)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  parent      Account?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    Account[]     @relation("AccountHierarchy")
  debitLines  JournalLine[] @relation("DebitAccount")
  creditLines JournalLine[] @relation("CreditAccount")

  @@map("accounts")
}

model JournalEntry {
  id           String    @id @default(uuid())
  code         String    @unique
  description  String
  reference    String?
  date         DateTime  @default(now())
  isAuto       Boolean   @default(false)
  // E1: audit trail — من أنشأ القيد (nullable للقيود الالية).
  createdById  String?
  createdAt    DateTime  @default(now())
  // A9: reversal tracking — القيد الأصلي يُعلَّم كمعكوس، والقيد العكسي يربط بـ reversalOfId.
  // لا cascade delete — العلاقة استشارية لحفظ سجل المراجعة.
  isReversed   Boolean   @default(false)
  reversalOfId String?
  reversedById String?
  reversedAt   DateTime?
  // A9: payload of linked side effects used for atomic reversal.
  metadata     Json?
  // Financial posting idempotency: same key + same hash replays; different hash conflicts.
  postingKey   String?
  postingHash  String?
  // E5: multi-currency — العملة التي أُنشئ بها القيد + سعر الصرف مقابل عملة النظام.
  // NULL = system default (EGP). exchangeRate defaults to 1.0 when currencyId is NULL.
  currencyId   String?
  exchangeRate Decimal?  @db.Decimal(10, 6)

  lines      JournalLine[]
  // E1: علاقة اختيارية للمستخدم (لا cascade delete — لا تُحذف القيود).
  createdBy  User?          @relation("JournalEntryCreator", fields: [createdById], references: [id])
  // A9: من عكس القيد (audit trail).
  reversedBy User?          @relation("JournalEntryReverser", fields: [reversedById], references: [id])
  // A9: علاقة ذاتية للربط بين القيد العكسي والأصلي.
  reversalOf JournalEntry?  @relation("JournalEntryReversal", fields: [reversalOfId], references: [id])
  reversals  JournalEntry[] @relation("JournalEntryReversal")
  // E5: FK to Currency (nullable — defaults to system EGP).
  currency   Currency?      @relation(fields: [currencyId], references: [id])
  vouchers   Voucher[]

  @@unique([reversalOfId])
  @@unique([postingKey])
  // Cluster 2 — B5/E4: فهارس للتقارير وحساب السنة المالية
  // A9: فهارس لاستعلامات العكس (المؤجلة / المنفذة).
  // E5: فهرس على currencyId لتقارير العملات الأجنبية.
  @@index([date])
  @@index([createdById, createdAt])
  @@index([reversalOfId])
  @@index([isReversed])
  @@index([currencyId])
  @@map("journal_entries")
}

model JournalLine {
  id              String  @id @default(uuid())
  journalEntryId  String
  debitAccountId  String
  creditAccountId String
  amount          Decimal @db.Decimal(15, 2)
  description     String?

  journalEntry  JournalEntry @relation(fields: [journalEntryId], references: [id])
  debitAccount  Account      @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccount Account      @relation("CreditAccount", fields: [creditAccountId], references: [id])

  @@map("journal_lines")
}

enum VoucherType {
  PAYMENT
  RECEIPT
}

model Voucher {
  id          String      @id @default(uuid())
  code        String      @unique
  type        VoucherType
  amount      Decimal     @db.Decimal(10, 2)
  description String
  reference   String?
  date        DateTime    @default(now())
  createdById String
  createdAt   DateTime    @default(now())

  // A3: ربط السند بقيد مالي حقيقي (لا قيد لا سند — لا أثر مالي خفي).
  journalEntryId   String?
  treasuryId       String?
  // Polymorphic counterparty — لا FK (يمكن أن يكون customer/supplier/worker).
  counterpartyType String?
  counterpartyId   String?

  createdBy    User?         @relation(fields: [createdById], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
  treasury     Treasury?     @relation(fields: [treasuryId], references: [id])

  // Cluster 2 — C5/C8: فهارس لتسريع استعلامات الـ treasury حسب النوع والتاريخ
  @@index([type, date])
  @@map("vouchers")
}

model Treasury {
  id         String    @id @default(uuid())
  name       String
  type       String // CASH or BANK
  balance    Decimal   @default(0) @db.Decimal(15, 2)
  isActive   Boolean   @default(true)
  // E2: soft-delete — الخزينة يُعلَّم كمحذوف بدل الحذف الفعلي (audit trail).
  // ملاحظة: لا تسمح بـ soft-delete إذا كان balance != 0 (يُيتم سندات مرتبطة).
  deletedAt  DateTime?
  // E5: multi-currency — كل خزينة لها عملة (EGP default).
  currencyId String?
  createdAt  DateTime  @default(now())

  // A3: السندات المرتبطة بهذه الخزينة (لا cascade delete — يُمنع حذف خزينة مرتبطة).
  vouchers Voucher[]
  // E5: FK to Currency (nullable for backfill — future PR makes it required).
  currency Currency? @relation(fields: [currencyId], references: [id])

  // Cluster 2 — B5: فهرس على isActive لفلترة الخزائن النشطة
  // E2: composite index على (isActive, deletedAt) — يحل محل الفهرس المنفرد.
  @@index([isActive, deletedAt])
  @@index([currencyId])
  @@map("treasuries")
}

// E5: Multi-currency support — Currency model with ISO 4217 code.
// Seeded with EGP (Egyptian Pound) as the system default + USD as reference.
model Currency {
  id            String   @id @default(uuid())
  code          String   @unique // ISO 4217: EGP, USD, EUR, etc.
  name          String
  symbol        String?
  decimalPlaces Int      @default(2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  treasuries     Treasury[]
  journalEntries JournalEntry[]

  @@map("currencies")
}

model CostCenter {
  id       String  @id @default(uuid())
  name     String
  code     String  @unique
  isActive Boolean @default(true)

  @@map("cost_centers")
}
