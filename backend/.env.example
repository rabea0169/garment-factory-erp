# ============================================================
# Garment Factory ERP — Backend Environment Template
# انسخه إلى .env (غير منشور في Git) واملأ القيم الفعلية.
# قاعدة: لا قيم حقيقية هنا أبدًا — هذا ملف قالب فقط.
# ============================================================

# --- Server ---
# منفذ الخدمة. ملاحظة: تطبيق Flutter حاليًا يطلب 3005 (انظر docs/DECISIONS.md ADR-0004)
PORT=3005

# --- Database (PostgreSQL) ---
# إلزامي — لا fallback في الكود. لا تضع قيمة إنتاجية هنا.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/garment_erp?schema=public

# --- Auth / JWT ---
# إلزامي في الإنتاج (32 حرفًا على الأقل). الإقلاع يفشل بدونه في production.
# توليد قيمة للتطوير: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM
# مدة صلاحية توكن الوصول (AUTH-1): القيم الموصى بها 15m-60m (الافتراضي 30m).
# استمرارية الجلسة مسؤولية دورة التحديث SEC-F04 (refresh token) لا طول عمر التوكن.
# تحذير: القيمة القديمة 7d كانت افتراضيًا خطِرًا — تُبطل فعالية revocation عند logout — لا تعد لاستخدامها.
JWT_EXPIRES_IN=30m

# --- CORS ---
# قائمة origins مفصولة بفواصل — لا تستخدم * في الإنتاج
CORS_ORIGINS=http://localhost:3000

# --- Environment ---
NODE_ENV=development

# --- Seed ---
# كلمة مرور المستخدم admin@factory.com الأولية عند تشغيل seed (لا قيمة افتراضية — أمنية)
# استخدم قيمة للتطوير فقط ولا تنشرها في أي مكان
SEED_ADMIN_PASSWORD=CHANGE_ME_DEV_ONLY

# ============================================================
# متغيرات docker-compose (تُقرأ من ملف .env بجذر المستودع عند تشغيل الحاويات)
# ============================================================
# POSTGRES_DB=garment_erp
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
