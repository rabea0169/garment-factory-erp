# GF-0006: لا أسرار في هذا الملف — كل القيم من البيئة (fail-fast عند النقص)
# انسخ هذا الملف إلى .env بجذر المستودع قبل docker compose up
# docker-compose يقرأ .env من جذر المستودع تلقائيًا لم substituted variables

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=garment_erp

# --- pgAdmin (profile اختياري: docker compose --profile tools up) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_TOO
